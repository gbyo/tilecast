# Installed Tilecast Server version. Keep stable to follow Stable releases,
# or pin an explicit release (for example 0.11.0) for controlled upgrades.
# Use development only to deliberately track main; it may be unstable.
TILECAST_VERSION=stable
POSTGRES_DB=tilecast
POSTGRES_USER=tilecast
POSTGRES_PASSWORD=replace-with-a-long-random-password
TILECAST_PORT=8080
TILECAST_PUBLIC_URL=http://tilecast.local:8080
# Set true only when the public URL is HTTPS.
TILECAST_COOKIE_SECURE=false
TILECAST_SESSION_TTL=24h
# Optional for Presentation Networks. When set, must decode to exactly 32 bytes
# as 64-character hex or standard/raw URL-safe Base64. Keep this key outside
# Tilecast database backups; it is required to decrypt saved Wi-Fi credentials.
TILECAST_PRESENTATION_NETWORK_KEY=
# Passkeys need HTTPS and a hostname, so they are unavailable on a plain-HTTP
# LAN installation. The relying party is derived from TILECAST_PUBLIC_URL;
# set these two together only when a proxy's external hostname differs from
# the address the server sees.
TILECAST_WEBAUTHN_RP_ID=
TILECAST_WEBAUTHN_ORIGINS=
TILECAST_LOG_LEVEL=info
TILECAST_MDNS_ENABLED=false
TILECAST_MAX_TAKEOVER_DURATION_HOURS=24
TILECAST_MAX_TAKEOVER_TARGETS=250
TILECAST_MAX_UPLOAD_BYTES=10737418240
TILECAST_MEDIA_WORKERS=2
TILECAST_MEDIA_RESERVED_FREE_BYTES=1073741824
TILECAST_VIDEO_MAX_WIDTH=1920
TILECAST_VIDEO_MAX_HEIGHT=1080
TILECAST_VIDEO_MAX_FRAME_RATE=60
TILECAST_KEEP_ORIGINALS=true
TILECAST_MAX_SCHEDULES=1000
TILECAST_MAX_SCHEDULE_TARGETS=250
TILECAST_MAX_GROUPS_PER_SCREEN=50
TILECAST_SCHEDULE_PREFETCH_DAYS=14
TILECAST_SCHEDULE_ACTIVATION_GRACE_SECONDS=30
TILECAST_CLOCK_SKEW_WARNING_SECONDS=300
TILECAST_WEBSITE_ALLOW_PRIVATE_HTTP=false
TILECAST_WEBSITE_DEFAULT_TIMEOUT_SECONDS=20
TILECAST_WEBSITE_MAX_TIMEOUT_SECONDS=120
TILECAST_WEBSITE_MIN_REFRESH_SECONDS=30
TILECAST_WEBSITE_MAX_ALLOWED_HOSTS=25
TILECAST_WEBSITE_MAX_ASSETS=500
TILECAST_SOURCE_ALLOW_PRIVATE_NETWORKS=false
TILECAST_SOURCE_FETCH_TIMEOUT_SECONDS=15
TILECAST_SOURCE_MAX_RESPONSE_BYTES=2097152
TILECAST_SOURCE_MAX_REDIRECTS=3
TILECAST_SOURCE_MIN_REFRESH_SECONDS=300
TILECAST_SOURCE_MAX_REFRESH_SECONDS=86400
# Commercial deployments should use an operator-managed Open-Meteo-compatible endpoint.
TILECAST_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com
TILECAST_MAX_PENDING_COMMANDS_PER_SCREEN=50
TILECAST_DEFAULT_COMMAND_EXPIRY_MINUTES=10
TILECAST_IDENTIFY_SCREEN_MAX_SECONDS=120
TILECAST_COMMAND_RETENTION_DAYS=30
# Optional Base64 raw Ed25519 public key override for custom Player builds.
# Official Tilecast images include the public release-verification key.
TILECAST_UPDATE_MANIFEST_PUBLIC_KEY=
TILECAST_UPDATE_MAX_APK_BYTES=536870912
TILECAST_UPDATE_RETENTION_DAYS=90
TILECAST_RELEASE_PUBLISH_TOKEN=
# Optional; raises GitHub API rate limits. Never commit a token.
TILECAST_GITHUB_TOKEN=
# Optional GitHub OAuth App client ID for Owner-authorized device sign-in.
# Enable Device Flow on the OAuth App before using Studio sign-in.
TILECAST_GITHUB_CLIENT_ID=
# Notification email. Leave TILECAST_SMTP_HOST empty to keep email off;
# webhooks still work. TILECAST_SMTP_TLS is starttls, implicit, or none.
# ALLOW_INSECURE accepts a relay certificate no public authority signed.
# ALLOW_PLAINTEXT_AUTH sends the SMTP password with no encryption at all, which
# is a separate decision and stays off unless you set it here.
TILECAST_SMTP_HOST=
TILECAST_SMTP_PORT=587
TILECAST_SMTP_USERNAME=
TILECAST_SMTP_PASSWORD=
TILECAST_SMTP_TLS=starttls
TILECAST_SMTP_ALLOW_INSECURE=false
TILECAST_SMTP_ALLOW_PLAINTEXT_AUTH=false
# Required only with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
