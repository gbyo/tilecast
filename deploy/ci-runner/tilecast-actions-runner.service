[Unit]
Description=Tilecast GitHub Actions overflow runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=tilecast-ci
Group=tilecast-ci
SupplementaryGroups=docker
WorkingDirectory=/opt/tilecast-actions-runner
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=/usr/local/lib/tilecast-ci/pre-job.sh
Environment=TILECAST_RUNNER_MAX_LOAD_PER_CPU=0.60
Environment=TILECAST_RUNNER_MIN_MEM_MIB=6144
Environment=TILECAST_RUNNER_MIN_DISK_GIB=30
Environment=TILECAST_RUNNER_MAX_WAIT_SECONDS=7200
ExecStart=/opt/tilecast-actions-runner/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
