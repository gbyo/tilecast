{
  "apiVersion": 3,
  "id": "provider_hooks",
  "definitionVersion": 1,
  "name": "Provider Hooks",
  "description": "Inbound webhooks of every Phase 3 mode.",
  "category": "Workflow",
  "icon": "puzzle",
  "maintainers": ["@gbyo"],
  "instanceNoun": {
    "singular": "item",
    "plural": "items"
  },
  "settings": {
    "organization": [
      {
        "key": "signingSecret",
        "label": "Signing secret",
        "control": "secret"
      },
      {
        "key": "standardSecret",
        "label": "Standard Webhooks secret",
        "control": "secret"
      },
      {
        "key": "region",
        "label": "Region",
        "control": "text",
        "maxLength": 40
      }
    ]
  },
  "webhooks": [
    {
      "id": "stripe_like",
      "title": "Pairs",
      "authentication": "signature",
      "signature": {
        "scheme": "hmac-sha256",
        "secret": "signingSecret",
        "header": "Example-Signature",
        "format": "pairs",
        "timestampKey": "t",
        "encoding": "hex",
        "signedPayload": "timestamp.body"
      },
      "deliveryId": {
        "pointer": "/id"
      },
      "handshake": {
        "type": "echo-json",
        "pointer": "/challenge"
      }
    }
  ]
}
