  "settings": {
    "organization": [
      {
        "key": "cloud",
        "label": "Cloud",
        "control": "connection",
        "connections": [
          "c0"
        ]
      },
      {
        "key": "cloudToken",
        "label": "Cloud token",
        "control": "secret",
        "maxLength": 512
      }
    ]
  },
  "instances": [
    {
      "kind": "meter",
      "noun": {
        "singular": "meter",
        "plural": "meters"
      },
      "path": "meters",
