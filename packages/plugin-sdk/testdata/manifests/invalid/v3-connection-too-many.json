{
  "apiVersion": 3,
  "id": "local_gateway",
  "definitionVersion": 1,
  "name": "Local Gateway",
  "description": "Read a meter gateway and a public API.",
  "category": "Workflow",
  "icon": "plug",
  "maintainers": [
    "@gbyo"
  ],
  "instanceNoun": {
    "singular": "meter",
    "plural": "meters"
  },
  "server": {
    "entrypoint": "./plugin.go"
