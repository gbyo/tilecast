        {
          "key": "gateway",
          "label": "Gateway",
          "control": "connection",
          "connections": [
            "c1"
          ],
          "required": true
        },
        {
          "key": "gatewayKey",
          "label": "Gateway key",
          "control": "secret"
        }
      ]
