{
  "apiVersion": 3,
  "id": "room_sign",
  "definitionVersion": 1,
  "name": "Room Sign",
  "description": "Show room bookings.",
  "category": "Display",
  "icon": "calendar",
  "maintainers": [
    "@gbyo"
  ],
  "instanceNoun": {
    "singular": "sign",
    "plural": "signs"
  },
  "server": {
    "entrypoint": "./plugin.go"
  },
  "api": {
    "basePaths": [
      "/plugins/room-sign"
    ]
  },
  "studio": {
    "route": "/plugins/room-sign"
  },
  "services": [
    "secrets.read@1",
    "organization.read@1"
  ],
  "settings": {
    "organization": [
      {
        "key": "apiToken",
        "label": "API token",
        "control": "secret",
        "maxLength": 512
      },
      {
        "key": "refreshMinutes",
        "label": "Refresh",
        "control": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 60
      }
    ],
    "screen": [
      {
        "key": "room",
        "label": "Room",
        "control": "text",
        "maxLength": 80
      }
    ]
  },
