                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": ["id"],
                "additionalProperties": false
              }
            },
            "v1ManifestTypes": {
              "default": [],
              "description": "Plugin API 1 manifest entry types the plugin still projects for Players that do not host Plugin API 2. Its Shared Runtime contribution also consumes them, so one implementation serves every Player.",
              "maxItems": 8,
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$" }
            }
          },
          "required": ["state"],
          "additionalProperties": false,
          "description": "Player contribution. Omit it for a plugin that has no Player behavior."
        }
      },
      "required": [
        "id",
        "definitionVersion",
        "name",
        "description",
        "category",
        "icon",
        "maintainers",
        "instanceNoun",
        "apiVersion"
      ],
      "additionalProperties": false,
      "description": "Tilecast plugin manifest (tilecast.plugin.json), Plugin API v2: independent Server, Studio, and Player contributions."
