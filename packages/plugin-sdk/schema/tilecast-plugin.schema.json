                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": ["source", "slug"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "apiVersion": {
          "type": "number",
          "const": 2,
          "description": "Version of the Tilecast Plugin API the plugin is written for."
        },
        "capabilities": {
          "default": { "backgroundWorkers": false, "network": [] },
          "description": "Server declarations. Player state is declared by the player contribution, not by a flag.",
          "type": "object",
          "properties": {
            "backgroundWorkers": { "default": false, "type": "boolean" },
            "network": {
              "default": [],
              "description": "Hosts Tilecast Server contacts for this plugin.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
              }
            }
          },
          "additionalProperties": false
        },
        "player": {
          "type": "object",
          "properties": {
            "state": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,79}$",
                    "description": "Player state type, unique across every plugin."
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": ["type", "version"],
                "additionalProperties": false
              },
              "description": "Player state the Server projects and the Player consumes. A Player contribution activates while state for it exists."
            },
            "runtime": {
              "description": "Portable Player behavior in the Shared Runtime.",
              "type": "object",
              "properties": {
                "entrypoint": {
                  "type": "string",
                  "const": "./runtime/index.ts",
                  "description": "Shared Player Runtime module that default-exports definePlayerPlugin. Always ./runtime/index.ts."
                },
                "services": {
                  "default": { "required": [], "optional": [] },
                  "type": "object",
                  "properties": {
                    "required": {
                      "default": [],
                      "description": "Services the contribution cannot run without. A Player that lacks one does not activate the contribution.",
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^([a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+)@([1-9][0-9]{0,5})$"
                      }
                    },
                    "optional": {
                      "default": [],
                      "description": "Enhancements. The contribution runs without them and receives null.",
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^([a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+)@([1-9][0-9]{0,5})$"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "surfaces": {
                  "default": [],
                  "description": "Visual contributions for player.surface@1. Empty for a plugin that draws nothing.",
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,39}$",
                        "description": "Contribution identifier, unique within the plugin."
                      },
                      "slots": {
                        "minItems": 1,
                        "maxItems": 7,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "strip.top",
                            "strip.bottom",
                            "corner.top-left",
                            "corner.top-right",
                            "corner.bottom-left",
                            "corner.bottom-right",
                            "overlay"
                          ]
                        },
                        "description": "Slots this contribution may claim."
                      },
                      "tier": {
                        "type": "string",
                        "enum": ["emergency", "live", "scheduled", "ambient"],
                        "description": "Arbitration tier of this contribution's claims. Reviewed here; a claim cannot choose it."
                      }
                    },
                    "required": ["id", "slots", "tier"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["entrypoint"],
              "additionalProperties": false
            },
            "native": {
              "default": [],
              "description": "First-party native contributions compiled into Player builds. Platforms register them through typed Player Core interfaces.",
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,39}$"
                  },
