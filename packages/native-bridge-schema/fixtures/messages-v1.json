{
  "$comment": "Shared corpus for every native bridge implementation. direction names the receiver's view: frontendToNative is decoded by the native host, nativeToFrontend and reply by Studio. outcome is accept, malformed, unknownType, or unsupportedVersion. schemaValid marks a malformed case that only a decoder can detect. destinationIds lists an accepted catalog in display order. encodes names a message that a native encoder must reproduce exactly.",
  "schemaVersion": 1,
  "cases": [
    {
      "name": "config/get",
      "direction": "frontendToNative",
      "outcome": "accept",
      "message": { "version": 1, "type": "config/get", "payload": {} }
