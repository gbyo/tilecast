{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilecast.org/schemas/native-bridge/v1.json",
  "title": "Tilecast native bridge, version 1",
  "description": "Messages between Tilecast Studio and a native host application. Every value is JSON. A receiver ignores unknown payload properties; removing or changing a property requires a new protocol version.",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "versionProbe": {
      "description": "Read first. A receiver refuses any version it does not implement before it inspects the rest of the message.",
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "messageType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
    },
    "requestId": {
      "description": "Optional correlation identifier. Replies echo it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "envelope": {
      "type": "object",
      "required": ["version", "type", "payload"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/requestId" },
        "type": { "$ref": "#/$defs/messageType" },
        "payload": { "type": "object" }
      }
    },
    "destinationId": {
      "description": "An opaque navigation destination identifier. Only Studio interprets it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "groupId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "title": {
      "description": "Display text, already localized by Studio.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "iconToken": {
      "description": "Advisory semantic icon. A host shows its generic icon for a token it does not recognize. See icon-tokens.json.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "emptyPayload": {
      "type": "object"
    },
    "navigationDestination": {
      "type": "object",
      "required": ["id", "title", "icon"],
      "properties": {
        "id": { "$ref": "#/$defs/destinationId" },
        "title": { "$ref": "#/$defs/title" },
        "icon": { "$ref": "#/$defs/iconToken" },
        "mobilePlacement": {
          "description": "Where a compact-width host prefers the destination. Omitted means more.",
          "enum": ["primary", "more"]
        }
      }
    },
    "navigationGroup": {
      "type": "object",
      "required": ["id", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/groupId" },
        "title": {
          "description": "Omitted for a group that has no heading.",
          "$ref": "#/$defs/title"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/navigationDestination" }
        }
      }
    },
    "navigationCatalogPayload": {
      "description": "A complete snapshot that replaces the previous catalog. Groups and items are in display order. Destination identifiers are unique across the catalog, and the catalog holds at most 128 destinations. No groups means native navigation is not available now.",
      "type": "object",
      "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/navigationGroup" }
        }
      }
    },
    "navigationStatePayload": {
      "type": "object",
      "required": ["activeDestinationId"],
      "properties": {
        "activeDestinationId": {
          "description": "The destination Studio resolved for the current location, or null when the location belongs to no destination. Authoritative for native selection.",
          "oneOf": [{ "$ref": "#/$defs/destinationId" }, { "type": "null" }]
        },
        "path": {
          "description": "The location path, without a query string. Diagnostics only. A host never derives selection from it.",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^/"
        }
      }
    },
    "frontendReadyPayload": {
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Capabilities Studio supports in this document. A capability that is absent or not true is unavailable, so a host never sends a message that needs it.",
          "type": "object",
          "properties": {
            "authLifecycle": {
              "description": "Studio handles auth/sign-out-request and reports auth/signed-out.",
              "type": "boolean"
            }
          }
        }
      }
    },
    "navigationRequestPayload": {
      "type": "object",
      "required": ["destinationId"],
      "properties": {
        "destinationId": { "$ref": "#/$defs/destinationId" }
      }
    },
    "configGetResult": {
      "description": "The payload of a successful config/get reply.",
      "type": "object",
      "required": ["protocolVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "description": "Capabilities the host offers. A capability that is absent or not true is unavailable.",
          "type": "object",
          "properties": {
            "nativeNavigation": { "type": "boolean" },
            "authLifecycle": {
              "description": "The host keeps a native credential whose lifecycle follows Studio's sign-out. Studio reports auth/signed-out only to a host that offers it.",
              "type": "boolean"
            }
          }
        }
      }
    },
    "frontendToNative": {
      "description": "Studio to the native host. Each message receives a reply.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "type": {
              "enum": [
                "config/get",
                "frontend/ready",
                "navigation/catalog",
                "navigation/state",
                "auth/signed-out"
              ]
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "config/get" } } },
          "then": {
            "properties": { "payload": { "$ref": "#/$defs/emptyPayload" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "frontend/ready" } } },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/frontendReadyPayload" }
            }
          }
        },
        {
          "description": "Studio completed its own sign-out. The payload carries no credential or account data.",
          "if": { "properties": { "type": { "const": "auth/signed-out" } } },
          "then": {
            "properties": { "payload": { "$ref": "#/$defs/emptyPayload" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "navigation/catalog" } } },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/navigationCatalogPayload" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "navigation/state" } } },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/navigationStatePayload" }
            }
          }
        }
      ]
    },
    "nativeToFrontend": {
      "description": "The native host to Studio.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "type": { "enum": ["navigation/request", "auth/sign-out-request"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "navigation/request" } } },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/navigationRequestPayload" }
            }
          }
        },
        {
          "description": "The host asks Studio to sign out with its normal logout. Studio answers with auth/signed-out when it is done. The payload carries no credential.",
          "if": {
            "properties": { "type": { "const": "auth/sign-out-request" } }
          },
          "then": {
            "properties": { "payload": { "$ref": "#/$defs/emptyPayload" } }
          }
        }
      ]
    },
    "reply": {
      "description": "The native host's reply to a frontendToNative message.",
      "type": "object",
      "required": ["version", "ok"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/requestId" },
        "ok": { "type": "boolean" },
        "payload": { "type": "object" },
        "error": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": {
              "enum": [
                "malformed",
                "unknown_type",
                "unsupported_version",
                "forbidden",
                "unavailable"
              ]
            },
            "supportedVersions": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "if": { "properties": { "ok": { "const": true } } },
      "then": {
        "required": ["payload"],
        "properties": { "payload": true, "error": false }
      },
      "else": {
        "required": ["error"],
        "properties": { "error": true, "payload": false }
      }
    }
  }
}
