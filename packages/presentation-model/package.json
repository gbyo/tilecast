{
  "name": "@tilecast/presentation-model",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Pure deterministic presentation decisions shared by Studio and Player Runtime.",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  }
}
