{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilecast.org/schemas/player-config-v1.json",
  "title": "Tilecast effective player configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configRevision",
    "generatedAt",
    "branding",
    "playback",
    "cache",
    "sync",
    "website",
    "reliability",
    "power",
    "managedKiosk",
    "accessibility"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "configRevision": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "branding": {
      "type": "object",
      "required": ["organizationName", "backgroundColor", "textColor"],
      "properties": {
        "organizationName": { "type": "string" },
        "logoAssetId": { "type": ["string", "null"], "format": "uuid" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "textColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      },
      "additionalProperties": true
    },
    "playback": {
      "type": "object",
      "required": ["defaultVolume", "defaultFitMode"],
      "properties": {
        "defaultVolume": { "type": "number", "minimum": 0, "maximum": 1 },
        "defaultFitMode": { "enum": ["contain", "cover", "stretch"] },
        "regionalFormat": {
          "description": "Optional organization-owned signage formatting profile. Added inside the extensible playback object so schema-v1 Players that ignore unknown playback properties remain compatible.",
          "type": "object",
          "required": [
            "locale",
            "timezone",
            "dateFormat",
            "timeFormat",
            "firstDayOfWeek"
          ],
          "properties": {
            "locale": { "type": "string", "minLength": 2, "maxLength": 255 },
            "timezone": { "type": "string", "minLength": 1, "maxLength": 200 },
            "dateFormat": {
              "enum": ["locale", "yyyy-MM-dd", "MM/dd/yyyy", "dd/MM/yyyy"]
            },
            "timeFormat": { "enum": ["locale", "12-hour", "24-hour"] },
            "firstDayOfWeek": {
              "enum": [
                "sunday",
                "monday",
                "tuesday",
                "wednesday",
                "thursday",
                "friday",
                "saturday"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "cache": {
      "type": "object",
      "required": ["maximumBytes", "minimumFreeBytes", "concurrentDownloads"],
      "properties": {
        "maximumBytes": { "type": "integer", "minimum": 268435456 },
        "minimumFreeBytes": { "type": "integer", "minimum": 134217728 },
        "concurrentDownloads": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "additionalProperties": true
    },
    "sync": {
      "type": "object",
      "required": ["manifestReconciliationSeconds", "statusReportSeconds"],
      "properties": {
        "manifestReconciliationSeconds": { "type": "integer", "minimum": 60 },
        "statusReportSeconds": { "type": "integer", "minimum": 15 }
      },
      "additionalProperties": false
    },
    "website": { "type": "object", "additionalProperties": true },
    "reliability": {
      "type": "object",
      "required": [
        "mode",
        "launchAfterBoot",
        "immersiveMode",
        "maximumProcessRestarts",
        "restartWindowMinutes",
        "safeModeEnabled"
      ],
      "properties": {
        "mode": { "enum": ["standard", "managed_kiosk"] },
        "launchAfterBoot": { "type": "boolean" },
        "immersiveMode": { "type": "boolean" },
        "maximumProcessRestarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "restartWindowMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "safeModeEnabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "power": {
      "type": "object",
      "required": [
        "activeHoursEnabled",
        "activeHoursTimezone",
        "activeHoursDays",
        "activeHoursStart",
        "activeHoursEnd",
        "keepScreenOn",
        "cecAssistEnabled"
      ],
      "properties": {
        "activeHoursEnabled": { "type": "boolean" },
        "activeHoursTimezone": { "type": "string" },
        "activeHoursDays": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 7 }
        },
        "activeHoursStart": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "activeHoursEnd": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "keepScreenOn": { "type": "boolean" },
        "cecAssistEnabled": { "type": "boolean" },
        "outsideActiveHoursDisplay": {
          "enum": ["bouncing_logo", "custom_text", "black"]
        },
        "outsideActiveHoursText": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": true
    },
    "managedKiosk": { "type": "object", "additionalProperties": true },
    "linuxKiosk": {
      "description": "Optional in schema v1: configurations generated before Linux kiosk policy existed omit this section, and players apply the hardened defaults (both settings enabled) when it is absent.",
      "type": "object",
      "required": ["fullscreenEnabled", "preventDisplaySleep"],
      "properties": {
        "fullscreenEnabled": { "type": "boolean" },
        "preventDisplaySleep": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "controlAssistEnabled": { "type": "boolean" },
        "returnDelaySeconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 300
        },
        "allowedPackages": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "maximumReturns": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "additionalProperties": true
    }
  }
}
