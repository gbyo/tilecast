      { "id": "test.service-01", "version": 1 },
      { "id": "test.service-02", "version": 1 },
      { "id": "test.service-03", "version": 1 },
      { "id": "test.service-04", "version": 1 },
      { "id": "test.service-05", "version": 1 },
      { "id": "test.service-06", "version": 1 },
      { "id": "test.service-07", "version": 1 },
      { "id": "test.service-08", "version": 1 }
