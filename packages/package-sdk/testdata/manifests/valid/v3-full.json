{
  "apiVersion": 3,
  "packageId": "acme.athletics",
  "packageVersion": "3.0.0",
  "name": "Athletics",
  "description": "Scoreboards and schedules.",
  "publisher": {
    "id": "acme",
    "name": "Acme Athletics"
  },
  "repository": "https://github.com/acme/tilecast-athletics",
  "license": "MIT",
  "tilecast": {
    "version": ">=1.2.0 <2.0.0"
  },
  "distribution": {
    "oci": "ghcr.io/acme/tilecast-athletics"
  },
  "contributions": [
    {
      "type": "widget",
      "path": "./widgets/scoreboard"
    }
  ],
  "runtime": {
    "module": "./runtime/plugin.wasm"
  },
  "capabilities": {
    "network": {
      "hosts": ["api.example.com", "stats.example.org"]
    },
    "background": {
      "jobs": [
        {
          "id": "refresh",
          "intervalMinutes": 60
        }
      ]
    },
    "storage": true,
    "studioUI": {
      "entry": "./studio/index.html"
    },
    "services": [
      {
        "id": "screens.read",
        "version": 1
      },
      {
        "id": "content.read",
        "version": 1
      },
      {
        "id": "takeovers.manage",
        "version": 1
      }
    ]
  }
}
