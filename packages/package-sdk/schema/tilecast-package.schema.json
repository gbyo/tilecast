{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gbyo/tilecast/packages/package-sdk/schema/tilecast-package.schema.json",
  "type": "object",
  "properties": {
    "apiVersion": {
      "anyOf": [
        { "type": "number", "const": 1 },
        { "type": "number", "const": 2 },
        { "type": "number", "const": 3 }
      ],
      "description": "Package manifest version. Versions 2 and 3 declare runtime and capabilities; only 3 declares service grants."
    },
    "packageId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "description": "Stable qualified package identity. Registry location is not identity."
    },
    "packageVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Release version of this package. Independent of contribution versions."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Human-readable package name."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "What the package adds."
    },
    "publisher": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "Publisher namespace. The package ID starts with it."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Human-readable publisher name."
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false,
      "description": "Who publishes this package."
    },
    "repository": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^https:\\/\\/[^/\\s]+\\/[^/\\s].{0,180}$",
      "description": "Public source repository of the package."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "SPDX license identifier such as MIT."
    },
    "tilecast": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:>=|<=|>|<|=)?\\d{1,5}(?:\\.\\d{1,5}){0,2}(?: (?:>=|<=|>|<|=)?\\d{1,5}(?:\\.\\d{1,5}){0,2})*$",
          "description": "Tilecast versions this package supports."
        }
      },
      "required": ["version"],
      "additionalProperties": false,
      "description": "Compatibility of this package."
    },
    "distribution": {
      "type": "object",
      "properties": {
        "oci": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._-]*(:[0-9]{1,5})?(\\/[a-z0-9_][a-z0-9._-]{0,63})+$",
          "description": "OCI artifact the installer resolves to a digest."
        }
      },
      "required": ["oci"],
      "additionalProperties": false,
      "description": "Where the installer fetches package bytes."
    },
    "contributions": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["plugin", "widget", "dataSource"],
            "description": "Which existing extension contract the nested manifest uses."
          },
          "path": {
            "type": "string",
            "pattern": "^\\.(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)+$",
            "description": "Directory inside the package holding the contribution manifest."
          }
        },
        "required": ["type", "path"],
        "additionalProperties": false
      },
      "description": "Extension contributions bundled in this package."
    },
    "documentation": {
      "description": "Documentation page for the package.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^https:\\/\\/[^/\\s]+\\/[^/\\s].{0,180}$"
    },
    "issues": {
      "description": "Issue tracker for the package.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^https:\\/\\/[^/\\s]+\\/[^/\\s].{0,180}$"
    },
    "runtime": {
      "description": "External server behavior module (versions 2 and 3).",
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^\\.(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)+$",
          "description": "Package-relative WebAssembly module for server behavior."
        }
      },
      "required": ["module"],
      "additionalProperties": false
    },
    "capabilities": {
      "description": "Bounded capabilities the package requests (versions 2 and 3; services are version 3 only).",
      "type": "object",
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "hosts": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?=.{1,253}$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
                "description": "Approved outbound HTTPS origin."
              },
              "description": "Approved outbound HTTPS origins."
            }
          },
          "required": ["hosts"],
          "additionalProperties": false,
          "description": "Approved outbound network access."
        },
        "background": {
          "type": "object",
          "properties": {
            "jobs": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,79}$",
                    "description": "Stable job identity within the package."
                  },
                  "intervalMinutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 1440,
                    "description": "How often the host runs the job, in minutes."
                  }
                },
                "required": ["id", "intervalMinutes"],
                "additionalProperties": false
              },
              "description": "Package-owned background jobs the host runs."
            }
          },
          "required": ["jobs"],
          "additionalProperties": false,
          "description": "Package-owned background behavior."
        },
        "storage": {
          "description": "Request plugin-owned key/value storage.",
          "type": "boolean",
          "const": true
        },
        "studioUI": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "pattern": "^\\.(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)+$",
              "description": "Package-relative entry page for the sandboxed Studio UI."
            }
          },
          "required": ["entry"],
          "additionalProperties": false,
          "description": "Sandboxed Studio UI entry."
        },
        "services": {
          "description": "Requested versioned Tilecast service grants (version 3 only).",
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
                "description": "Stable Tilecast service capability identity."
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99,
                "description": "Requested service capability version."
              }
            },
            "required": ["id", "version"],
            "additionalProperties": false,
            "description": "One requested Tilecast service grant."
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "packageId",
    "packageVersion",
    "name",
    "description",
    "publisher",
    "repository",
    "license",
    "tilecast",
    "distribution",
    "contributions"
  ],
  "additionalProperties": false,
  "description": "Tilecast package manifest (tilecast.package.json)."
}
