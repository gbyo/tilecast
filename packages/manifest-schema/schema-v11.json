{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilecast.org/schemas/player-manifest-v11.json",
  "title": "Tilecast Widget and Data Source presentation manifest v11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "screenId",
    "generatedAt",
    "serverTime",
    "mode",
    "playlists",
    "layouts",
    "schedules",
    "assets",
    "websites",
    "widgets",
    "dataSources",
    "prefetchHorizonDays",
    "activationGraceSeconds"
  ],
  "properties": {
    "schemaVersion": { "const": 11 },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "screenId": { "type": "string", "format": "uuid" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "serverTime": { "type": "string", "format": "date-time" },
    "mode": { "const": "presentation" },
    "playlist": { "$ref": "schema-v5.json#/$defs/playlist" },
    "directFallbackPlaylist": { "$ref": "schema-v5.json#/$defs/playlist" },
    "playlists": {
      "type": "array",
      "items": { "$ref": "schema-v5.json#/$defs/playlist" }
    },
    "layout": { "$ref": "#/$defs/layout" },
    "directFallbackLayout": { "$ref": "#/$defs/layout" },
    "layouts": { "type": "array", "items": { "$ref": "#/$defs/layout" } },
    "schedules": { "type": "array", "items": { "$ref": "#/$defs/schedule" } },
    "assets": {
      "type": "array",
      "items": { "$ref": "schema-v1.json#/$defs/asset" }
    },
    "websites": {
      "type": "array",
      "items": { "$ref": "schema-v4.json#/$defs/website" }
    },
    "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } },
    "dataSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataSource" }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    },
    "emergency": { "$ref": "schema-v4.json#/$defs/emergency" },
    "syncGroup": { "$ref": "schema-v9.json#/properties/syncGroup" },
    "prefetchHorizonDays": { "type": "integer", "minimum": 1, "maximum": 90 },
    "activationGraceSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  },
  "$defs": {
    "plugin": {
      "description": "One built-in plugin surface delivered beside the presentation. Each type carries its own configuration; a Player ignores a type it does not implement.",
      "oneOf": [
        { "$ref": "#/$defs/countdownBarPlugin" },
        { "$ref": "#/$defs/alertTickerPlugin" },
        { "$ref": "#/$defs/brandBugPlugin" },
        { "$ref": "#/$defs/noiseMeterPlugin" }
      ]
    },
    "countdownBarPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "config"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "const": "countdown_bar" },
        "version": { "const": 1 },
        "config": { "$ref": "#/$defs/countdownBarConfig" }
      }
    },
    "alertTickerPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "config"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "const": "alert_ticker" },
        "version": { "const": 1 },
        "config": { "$ref": "#/$defs/alertTickerConfig" }
      }
    },
    "brandBugPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "config"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "const": "brand_bug" },
        "version": { "const": 1 },
        "config": { "$ref": "#/$defs/brandBugConfig" }
      }
    },
    "noiseMeterPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "config"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "const": "noise_meter" },
        "version": { "const": 1 },
        "config": { "$ref": "#/$defs/noiseMeterConfig" }
      }
    },
    "noiseMeterConfig": {
      "description": "Thresholds for a Player-local room noise bar. Levels are a normalized 0-100 scale relative to that Player's own microphone, never decibels, dBA, or SPL: a generic USB microphone has no calibrated sensitivity to express one. No audio, sample, or device identifier travels in either direction. The two thresholds are deliberately separate so showing and hiding never share one value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "warningLevel",
        "loudLevel",
        "sensitivity",
        "triggerHoldMs",
        "clearHoldMs",
        "displayMode",
        "heightPx"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "message": { "type": "string", "maxLength": 120 },
        "warningLevel": { "type": "integer", "minimum": 1, "maximum": 99 },
        "loudLevel": { "type": "integer", "minimum": 2, "maximum": 100 },
        "sensitivity": { "type": "integer", "minimum": 25, "maximum": 300 },
        "triggerHoldMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "clearHoldMs": { "type": "integer", "minimum": 500, "maximum": 30000 },
        "displayMode": { "enum": ["overlay", "push"] },
        "heightPx": { "type": "integer", "minimum": 40, "maximum": 320 },
        "historyEnabled": { "type": "boolean" },
        "historyRetentionDays": { "enum": [1, 3, 7, 14, 30] },
        "historyActiveHoursOnly": { "type": "boolean" },
        "scheduleEnabled": {
          "type": "boolean",
          "description": "When false the bar may show whenever the room is too loud."
        },
        "scheduleDaysOfWeek": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 7,
          "items": { "type": "integer", "minimum": 0, "maximum": 6 },
          "description": "Days the window may start on, Sunday 0 through Saturday 6."
        },
        "scheduleStartTime": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "scheduleEndTime": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "scheduleTimezone": { "type": "string", "maxLength": 100 }
      }
    },
    "brandBugConfig": {
      "description": "A mark held in one screen corner over all normal content. Sizing is screen-relative, so one instance reads the same on a 1080p panel and a 4K one. A mark must draw a logo, text, or both.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "corner",
        "widthPercent",
        "textSizePercent",
        "opacityPercent",
        "marginPercent",
        "textColor",
        "backgroundStyle",
        "priority"
      ],
      "anyOf": [
        { "required": ["imageAssetId"] },
        {
          "required": ["text"],
          "properties": { "text": { "pattern": "\\S" } }
        }
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "corner": {
          "enum": ["top_left", "top_right", "bottom_left", "bottom_right"]
        },
        "imageAssetId": { "type": "string", "format": "uuid" },
        "imageVariantId": { "type": "string", "format": "uuid" },
        "text": { "type": "string", "maxLength": 180 },
        "widthPercent": { "type": "integer", "minimum": 2, "maximum": 40 },
        "textSizePercent": { "type": "integer", "minimum": 1, "maximum": 12 },
        "opacityPercent": { "type": "integer", "minimum": 10, "maximum": 100 },
        "marginPercent": { "type": "integer", "minimum": 0, "maximum": 20 },
        "textColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundStyle": { "enum": ["none", "scrim"] },
        "startsAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
      }
    },
    "alertTickerConfig": {
      "description": "A live emergency alert delivered as a bar rather than as a takeover. The message is composed by the server from the alert itself, so the Player renders text rather than resolving a schedule. `expiresAt` is the Player's own stop condition: a cached manifest must not keep showing an alert that may be over.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "message",
        "displayMode",
        "heightPx",
        "speed",
        "priority",
        "expiresAt"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "severity": { "type": "string", "maxLength": 32 },
        "event": { "type": "string", "maxLength": 200 },
        "displayMode": { "enum": ["overlay", "push"] },
        "heightPx": { "type": "integer", "minimum": 40, "maximum": 320 },
        "speed": { "enum": ["slow", "medium", "fast"] },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "countdownBarConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "message",
        "scheduleType",
        "timezone",
        "leadTimeSeconds",
        "displayMode",
        "heightPx",
        "priority"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "message": { "type": "string", "minLength": 1, "maxLength": 280 },
        "scheduleType": { "enum": ["weekly", "one_time"] },
        "targetTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "daysOfWeek": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 6 }
        },
        "oneTimeAt": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "leadTimeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "completionText": { "type": "string", "maxLength": 280 },
        "showConfetti": { "type": "boolean" },
        "displayMode": { "enum": ["overlay", "push"] },
        "heightPx": { "type": "integer", "minimum": 40, "maximum": 320 },
        "progressFill": { "enum": ["none", "drain"] },
        "contentPadding": { "type": "integer", "minimum": 0, "maximum": 40 },
        "textScale": { "type": "integer", "minimum": 25, "maximum": 500 },
        "urgencyEnabled": { "type": "boolean" },
        "startingSoonSeconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 86400
        },
        "urgentSeconds": { "type": "integer", "minimum": 2, "maximum": 3600 },
        "pulseSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
      },
      "allOf": [
        {
          "if": { "properties": { "scheduleType": { "const": "weekly" } } },
          "then": { "required": ["targetTime", "daysOfWeek"] },
          "else": { "required": ["oneTimeAt"] }
        }
      ]
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "description": "A renderable Widget. Data-driven Widgets reference a Data Source by dataSourceId inside configuration and never embed the cached dataset.",
      "required": [
        "assetId",
        "name",
        "provider",
        "configVersion",
        "configuration"
      ],
      "properties": {
        "assetId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "provider": {
          "enum": [
            "website",
            "youtube",
            "clock",
            "date",
            "qrcode",
            "ticker",
            "menu",
            "list",
            "table",
            "agenda"
          ]
        },
        "configVersion": { "type": "integer", "minimum": 1 },
        "configuration": { "type": "object" }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Data Source projected once and shared by every Widget or binding that consumes it. configuration carries the bounded cached dataset and the date-selection policy the Player applies locally.",
      "required": ["id", "name", "provider", "configVersion", "configuration"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "provider": {
          "enum": ["calendar", "rss", "atom", "json", "csv"]
        },
        "configVersion": { "type": "integer", "minimum": 1 },
        "configuration": { "type": "object" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revisionId",
        "revision",
        "documentSha256",
        "document"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "revisionId": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "documentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "document": { "$ref": "../layout-schema/schema-v2.json" },
        "fonts": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/layoutFont" }
        }
      }
    },
    "layoutFont": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "faces"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "family": { "type": "string", "minLength": 1, "maxLength": 100 },
        "faces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetId",
              "variantId",
              "style",
              "weightMin",
              "weightMax"
            ],
            "properties": {
              "assetId": { "type": "string", "format": "uuid" },
              "variantId": { "type": "string", "format": "uuid" },
              "style": { "enum": ["normal", "italic"] },
              "weightMin": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "weightMax": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "unicodeRange": { "type": "string", "maxLength": 4000 }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "timezone", "priority", "specificity"],
      "oneOf": [{ "required": ["playlistId"] }, { "required": ["layoutId"] }],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "playlistId": { "type": "string", "format": "uuid" },
        "layoutId": { "type": "string", "format": "uuid" },
        "type": { "enum": ["one_time", "weekly"] },
        "timezone": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": -999, "maximum": 999 },
        "specificity": { "enum": [0, 1] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "oneTimeStart": { "type": "string", "format": "date-time" },
        "oneTimeEnd": { "type": "string", "format": "date-time" },
        "dailyStart": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "dailyEnd": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "daysOfWeek": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 6 },
          "uniqueItems": true
        }
      }
    }
  }
}
