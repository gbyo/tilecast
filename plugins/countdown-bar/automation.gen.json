              "minimum": 25,
              "maximum": 500
            },
            "fontId": {
              "type": "string",
              "format": "uuid",
              "description": "Add fonts in Settings. Screens that cannot load the font keep the default."
            },
            "urgencyEnabled": {
              "type": "boolean",
              "description": "Change the bar automatically as the target approaches."
            },
            "startingSoonSeconds": {
              "type": "integer",
              "description": "Starting soon (orange), minutes before",
              "minimum": 2,
              "maximum": 86400
            },
            "urgentSeconds": {
              "type": "integer",
              "description": "Urgent (red), seconds before",
              "minimum": 2,
              "maximum": 3600
            },
            "pulseSeconds": {
              "type": "integer",
              "description": "The bar and text grow by 25% during this final stage.",
              "minimum": 1,
              "maximum": 60
            },
            "priority": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "targetScope": {
              "type": "string",
              "enum": ["all", "screens", "sync_groups", "locations"]
            },
            "targetIds": {
              "type": "array",
              "maxItems": 250,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "expectedRevision": {
              "type": "integer",
              "description": "The revision this change is based on, from the last read. A stale revision answers 409 and changes nothing; a missing one answers 428.",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "operationId": "deleteCountdownBarInstance",
      "method": "delete",
      "path": "/api/v1/plugins/countdown-bar/instances/{id}",
      "risk": "sensitive",
      "cliPath": ["countdown-bar", "instance", "delete"],
      "mcpAction": "delete_instance",
      "pathParams": [
        {
          "name": "id",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "queryParams": [],
      "description": "Delete a countdown bar from its target screens."
    }
  ],
  "exclusions": []
