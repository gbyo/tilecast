      "operationId": "listCountdownBarInstances",
      "method": "get",
      "path": "/api/v1/plugins/countdown-bar/instances",
      "risk": "read",
      "cliPath": ["countdown-bar", "instance", "list"],
      "mcpAction": "list_instances",
      "pathParams": [],
      "queryParams": [],
      "description": "List the configured Countdown Bar instances."
    },
    {
      "operationId": "getCountdownBarInstance",
      "method": "get",
      "path": "/api/v1/plugins/countdown-bar/instances/{id}",
      "risk": "read",
      "cliPath": ["countdown-bar", "instance", "get"],
      "mcpAction": "get_instance",
      "pathParams": [
        {
          "name": "id",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "queryParams": [],
      "description": "Show one Countdown Bar instance."
    },
    {
      "operationId": "createCountdownBarInstance",
      "method": "post",
      "path": "/api/v1/plugins/countdown-bar/instances",
      "risk": "routine",
      "cliPath": ["countdown-bar", "instance", "create"],
      "mcpAction": "create_instance",
      "pathParams": [],
      "queryParams": [],
      "input": "document",
      "description": "Create a Countdown Bar instance from a JSON document.",
      "requestBody": {
        "required": true,
        "schema": {
          "type": "object",
          "required": [
            "name",
            "message",
            "scheduleType",
            "daysOfWeek",
            "timezone",
            "leadTimeSeconds",
            "completionText",
            "showConfetti",
            "displayMode",
            "heightPx",
            "urgencyEnabled",
            "startingSoonSeconds",
            "urgentSeconds",
            "pulseSeconds",
            "enabled",
            "priority",
            "targetScope",
            "targetIds"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            "scheduleType": {
              "type": "string",
              "enum": ["weekly", "one_time"]
            },
            "targetTime": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "daysOfWeek": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "oneTimeAt": {
              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "leadTimeSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 2592000
            },
            "completionText": {
              "type": "string",
              "maxLength": 280
            },
            "showConfetti": {
              "type": "boolean",
              "description": "Show a short confetti fall from the top of the Player when the countdown reaches zero. This does not require completion text."
            },
            "displayMode": {
              "type": "string",
              "enum": ["overlay", "push"]
            },
            "heightPx": {
              "type": "integer",
              "minimum": 40,
              "maximum": 320
            },
            "progressFill": {
              "type": "string",
              "description": "Background treatment behind the bar text. \"drain\" starts the bar fully tinted when the lead window opens and retreats the tint leftward as the target approaches, leaving only the bar background at zero. Omitted means \"none\".",
              "default": "none",
              "enum": ["none", "drain"]
            },
            "contentPadding": {
              "type": "integer",
              "description": "Share of each side left as a gutter, as a percentage of the bar width. Lowering it gives a long message or a larger type size more room. The default 4 matches the bar's original gutters.",
              "minimum": 0,
              "maximum": 40
            },
            "textScale": {
              "type": "integer",
              "description": "Percentage applied to the height-derived type size, so a bar can carry larger text without changing its height. 100 is the original appearance.",
              "minimum": 25,
              "maximum": 500
            },
            "urgencyEnabled": {
              "type": "boolean",
              "description": "Enable automatic starting-soon, urgent, and final pulse stages."
            },
            "startingSoonSeconds": {
              "type": "integer",
              "minimum": 2,
              "maximum": 86400
            },
            "urgentSeconds": {
              "type": "integer",
              "minimum": 2,
              "maximum": 3600
            },
            "pulseSeconds": {
              "type": "integer",
              "description": "Final seconds during which the urgent bar pulses and grows by 25 percent.",
              "minimum": 1,
              "maximum": 60
            },
            "enabled": {
              "type": "boolean"
            },
            "priority": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "targetScope": {
              "type": "string",
              "enum": ["all", "screens", "sync_groups", "locations"]
            },
            "targetIds": {
              "type": "array",
              "maxItems": 250,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
