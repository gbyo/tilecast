{
  "apiVersion": 1,
  "plugin": "countdown_bar",
  "operations": [
    {
      "operationId": "listCountdownBarInstances",
      "method": "get",
      "path": "/api/v1/plugins/countdown-bar/instances",
      "risk": "read",
      "cliPath": ["countdown-bar", "instance", "list"],
      "mcpAction": "list_instances",
      "pathParams": [],
      "queryParams": [],
      "description": "List the countdown bars."
    },
    {
      "operationId": "getCountdownBarInstance",
      "method": "get",
      "path": "/api/v1/plugins/countdown-bar/instances/{id}",
      "risk": "read",
      "cliPath": ["countdown-bar", "instance", "get"],
      "mcpAction": "get_instance",
      "pathParams": [
        {
          "name": "id",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "queryParams": [],
      "description": "Show one countdown bar."
    },
    {
      "operationId": "createCountdownBarInstance",
      "method": "post",
      "path": "/api/v1/plugins/countdown-bar/instances",
      "risk": "routine",
      "cliPath": ["countdown-bar", "instance", "create"],
      "mcpAction": "create_instance",
      "pathParams": [],
      "queryParams": [],
      "input": "document",
      "description": "Create a countdown bar from a JSON document.",
      "requestBody": {
        "required": true,
        "schema": {
          "type": "object",
          "required": ["name", "targetScope", "targetIds", "timezone"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "enabled": {
              "type": "boolean",
              "description": "Defaults to true on create and keeps its value on update."
            },
            "message": {
              "type": "string",
              "description": "Message",
              "default": "Lunch ends in",
              "maxLength": 1120
            },
            "completionText": {
              "type": "string",
              "description": "Shown for one minute after the target; leave blank to hide at zero.",
              "maxLength": 1120
            },
            "showConfetti": {
              "type": "boolean",
              "description": "Show confetti when the countdown reaches zero"
            },
            "scheduleType": {
              "type": "string",
              "description": "Schedule",
              "default": "weekly",
              "enum": ["weekly", "one_time"]
            },
            "targetTime": {
              "type": "string",
              "description": "Target time",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "daysOfWeek": {
              "type": "array",
              "description": "Days of the week",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "oneTimeAt": {
              "type": "string",
              "format": "date-time",
              "description": "The Player counts down to this instant."
            },
            "timezone": {
              "type": "string",
              "description": "Timezone"
            },
            "leadTimeSeconds": {
              "type": "integer",
              "description": "Appear this many minutes before",
              "minimum": 60,
              "maximum": 2592000
            },
            "displayMode": {
              "type": "string",
              "description": "Mode",
              "default": "overlay",
              "enum": ["overlay", "push"]
            },
            "heightPx": {
              "type": "integer",
              "description": "Bottom-bar height (px)",
              "minimum": 40,
              "maximum": 320
            },
            "progressFill": {
              "type": "string",
              "description": "Drain empties the bar from right to left as the target approaches.",
              "default": "none",
              "enum": ["none", "drain"]
            },
            "contentPadding": {
              "type": "integer",
              "description": "Lower padding gives the message and countdown more room.",
              "minimum": 0,
              "maximum": 40
            },
            "textScale": {
              "type": "integer",
              "description": "Increase the type size without changing the bar height.",
              "minimum": 25,
              "maximum": 500
            },
            "fontId": {
              "type": "string",
              "format": "uuid",
              "description": "Add fonts in Settings. Screens that cannot load the font keep the default."
            },
            "urgencyEnabled": {
              "type": "boolean",
              "description": "Change the bar automatically as the target approaches."
            },
            "startingSoonSeconds": {
              "type": "integer",
              "description": "Starting soon (orange), minutes before",
              "minimum": 2,
              "maximum": 86400
            },
            "urgentSeconds": {
              "type": "integer",
              "description": "Urgent (red), seconds before",
              "minimum": 2,
              "maximum": 3600
            },
            "pulseSeconds": {
              "type": "integer",
              "description": "The bar and text grow by 25% during this final stage.",
              "minimum": 1,
              "maximum": 60
            },
            "priority": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "targetScope": {
              "type": "string",
              "enum": ["all", "screens", "sync_groups", "locations"]
            },
            "targetIds": {
              "type": "array",
              "maxItems": 250,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
