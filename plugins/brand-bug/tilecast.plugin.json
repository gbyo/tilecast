{
  "$schema": "../../packages/plugin-sdk/schema/tilecast-plugin.schema.json",
  "apiVersion": 1,
  "id": "brand_bug",
  "definitionVersion": 1,
  "name": "Brand Bug / Watermark",
  "description": "Keep a logo, sponsor mark, legal notice, campaign badge, or location label in a corner over all normal content.",
  "category": "Display",
  "icon": "stamp",
  "maintainers": ["@gbyo"],
  "instanceNoun": { "singular": "mark", "plural": "marks" },
  "requirements": [
    {
      "kind": "player",
      "label": "Player plugin support",
      "description": "Target screens need a Player build that renders plugin overlays."
    }
  ],
  "uses": ["Player manifest plugin state", "Persistent corner overlay"],
  "capabilities": { "playerManifest": true },
  "server": { "entrypoint": "./plugin.go" },
  "studio": {
    "route": "/plugins/brand-bug",
    "entrypoint": "./studio/index.tsx"
  },
  "docs": { "reference": "docs/plugins.md#brand-bug--watermark" }
}
