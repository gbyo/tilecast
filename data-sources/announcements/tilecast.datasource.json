{
  "$schema": "../../packages/data-source-sdk/schema/tilecast-datasource.schema.json",
  "apiVersion": 1,
  "id": "announcements",
  "version": 1,
  "name": "Announcements",
  "description": "Maintain a list of announcements that publish and expire on their own.",
  "category": "Structured",
  "icon": "megaphone",
  "configurationSchema": {
    "fields": [
      {
        "key": "records",
        "label": "Announcements",
        "description": "Rows appear only inside their publish window. Higher priority sorts first.",
        "control": "repeating_group",
        "maximumItems": 60,
        "itemFields": [
          {
            "key": "title",
            "label": "Title",
            "control": "text",
            "required": true,
            "minLength": 1,
            "maxLength": 160,
            "default": "Announcement"
          },
          {
            "key": "body",
            "label": "Details",
            "control": "multiline_text",
            "default": "",
            "maxLength": 1000
          },
          {
            "key": "category",
            "label": "Category",
            "control": "text",
            "default": "",
            "maxLength": 60
          },
          {
            "key": "priority",
            "label": "Priority",
            "control": "integer",
            "required": true,
            "default": 0,
            "minimum": 0,
            "maximum": 100
          },
          {
            "key": "publishAt",
            "label": "Publish at",
            "control": "datetime"
          },
          {
            "key": "expiresAt",
            "label": "Expires at",
            "control": "datetime"
          }
        ]
      }
    ]
  },
  "defaultConfiguration": {
    "records": []
  },
  "outputSchema": {
    "kind": "records",
    "fields": [
      {
        "key": "title",
        "label": "Title",
        "type": "text",
        "required": true
      },
      {
        "key": "body",
        "label": "Details",
        "type": "text"
      },
      {
        "key": "category",
        "label": "Category",
        "type": "text"
      },
      {
        "key": "priority",
        "label": "Priority",
        "type": "integer"
      },
      {
        "key": "publishAt",
        "label": "Publish at",
        "type": "datetime"
      },
      {
        "key": "expiresAt",
        "label": "Expires at",
        "type": "datetime"
      }
    ]
  },
  "adapterId": "manual_records",
  "refreshBehavior": "manual",
  "requiresManifestV13": true,
  "setup": {
    "eyebrow": "Maintained in Studio",
    "tip": "Set an expiry when you add the row. Expired announcements disappear from every screen on their own, with no cleanup pass.",
    "steps": [
      "Add a row for each announcement.",
      "Set a publish time for anything that should wait, and an expiry for anything time-limited.",
      "Select it from a List, Ticker, Cards, or Now and Next Widget."
    ]
  },
  "deprecation": {}
}
