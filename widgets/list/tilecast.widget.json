{
  "$schema": "../../packages/widget-sdk/schema/tilecast-widget.schema.json",
  "apiVersion": 1,
  "id": "list",
  "version": 1,
  "configVersion": 2,
  "name": "List",
  "description": "Show records as flexible primary and secondary rows.",
  "category": "Data display",
  "icon": "list",
  "runtime": "native",
  "configurationSchema": {
    "fields": [
      {
        "key": "dataSourceId",
        "label": "Data Source",
        "description": "The records source this List reads.",
        "control": "data_source",
        "acceptedDataSourceKinds": ["records"],
        "default": "",
        "ui": { "section": "data", "order": 1 }
      },
      {
        "key": "primaryField",
        "label": "Primary field",
        "description": "The main value of each row.",
        "control": "data_source_field",
        "dataSourceFieldTypes": [
          "text",
          "number",
          "integer",
          "currency",
          "boolean",
          "date",
          "datetime",
          "url"
        ],
        "default": "",
        "ui": { "section": "data", "order": 2 }
      },
      {
        "key": "secondaryField",
        "label": "Secondary field",
        "description": "A quieter value under the primary one.",
        "control": "data_source_field",
        "dataSourceFieldTypes": [
          "text",
          "number",
          "integer",
          "currency",
          "boolean",
          "date",
          "datetime",
          "url"
        ],
        "default": "",
        "ui": { "section": "data", "order": 3 }
      },
      {
        "key": "leadingField",
        "label": "Leading field",
        "description": "A small value at the start of each row.",
        "control": "data_source_field",
        "dataSourceFieldTypes": [
          "text",
          "number",
          "integer",
          "currency",
          "boolean",
          "date",
          "datetime",
          "url"
        ],
        "default": "",
        "ui": { "section": "data", "order": 4 }
      },
      {
        "key": "trailingField",
        "label": "Trailing field",
        "description": "A value aligned to the end of each row.",
        "control": "data_source_field",
        "dataSourceFieldTypes": [
          "text",
          "number",
          "integer",
          "currency",
          "boolean",
          "date",
          "datetime",
          "url"
        ],
        "default": "",
        "ui": { "section": "data", "order": 5 }
      },
      {
        "key": "heading",
        "label": "Heading",
        "control": "text",
        "maxLength": 120,
        "default": "",
        "ui": { "section": "content", "order": 1 }
      },
      {
        "key": "maximumItems",
        "label": "Maximum items",
        "control": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 8,
        "ui": { "section": "content", "order": 2 }
      },
      {
        "key": "emptyText",
        "label": "Empty message",
        "description": "Shown when the source returns no usable records.",
        "control": "text",
        "maxLength": 200,
        "default": "",
        "ui": { "section": "content", "order": 3 }
      },
      {
        "key": "density",
        "label": "Density",
        "control": "select",
        "options": [
          { "value": "comfortable", "label": "Comfortable" },
          { "value": "compact", "label": "Compact" }
        ],
        "default": "comfortable",
        "ui": { "section": "appearance", "order": 1, "styleCard": true }
      },
      {
        "key": "showDividers",
        "label": "Dividers",
        "description": "Draw a line between rows.",
        "control": "boolean",
        "default": true,
        "ui": { "section": "appearance", "order": 2 }
      },
      {
        "key": "backgroundColor",
        "label": "Background color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 3 }
      },
      {
        "key": "foregroundColor",
        "label": "Text color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 4 }
      },
      {
        "key": "textScale",
        "label": "Text scale",
        "control": "integer",
        "minimum": 25,
        "maximum": 500,
        "ui": { "hidden": true }
      },
      {
        "key": "contentPadding",
        "label": "Content padding",
        "control": "integer",
        "minimum": 0,
        "maximum": 40,
        "ui": { "hidden": true }
      }
    ]
  },
  "defaultConfiguration": {
    "dataSourceId": "",
    "primaryField": "",
    "secondaryField": "",
    "leadingField": "",
    "trailingField": "",
    "heading": "",
    "maximumItems": 8,
    "emptyText": "",
    "density": "comfortable",
    "showDividers": true,
    "backgroundColor": "",
    "foregroundColor": ""
  },
  "presentationSchemaVersion": 1,
  "requiredCapabilities": {
    "layout.surface": 1,
    "layout.column": 1,
    "collection.repeat": 2,
    "content.text": 1,
    "binding.core": 2
  },
  "emptyStateBehavior": "text",
  "legacyEditor": true,
  "deprecation": {},
  "component": {
    "type": "tilecast.list",
    "version": 1,
    "tagName": "tc-widget-list",
    "entrypoint": "./runtime/index.ts",
    "configTemplate": {
      "dataSourceId": { "$config": "dataSourceId", "default": "" },
      "primaryField": { "$config": "primaryField", "default": "" },
      "secondaryField": { "$config": "secondaryField", "default": "" },
      "leadingField": { "$config": "leadingField", "default": "" },
      "trailingField": { "$config": "trailingField", "default": "" },
      "heading": { "$config": "heading", "default": "" },
      "maximumItems": { "$config": "maximumItems", "default": 8 },
      "emptyText": {
        "$config": "emptyText",
        "default": { "$config": "emptyState", "default": "" }
      },
      "density": {
        "$config": "density",
        "default": { "$config": "rowSpacing", "default": "comfortable" }
      },
      "showDividers": { "$config": "showDividers", "default": true },
      "background": { "$config": "backgroundColor", "default": "" },
      "foreground": { "$config": "foregroundColor", "default": "" }
    },
    "dataSourceFields": ["dataSourceId"],
    "empty": "skip-eligible"
  },
  "compatibility": {
    "fallback": "legacy"
  }
}
