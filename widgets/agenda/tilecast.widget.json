{
  "$schema": "../../packages/widget-sdk/schema/tilecast-widget.schema.json",
  "apiVersion": 1,
  "id": "agenda",
  "version": 1,
  "configVersion": 2,
  "name": "Agenda",
  "description": "Group upcoming events by day with now and relative status.",
  "category": "Information",
  "icon": "calendar",
  "runtime": "native",
  "configurationSchema": {
    "fields": [
      {
        "key": "dataSourceId",
        "label": "Data Source",
        "description": "The calendar or records source this Agenda reads.",
        "control": "data_source",
        "acceptedDataSourceKinds": ["records"],
        "default": "",
        "ui": { "section": "data", "order": 1 }
      },
      {
        "key": "titleField",
        "label": "Title field",
        "description": "The event name in each row.",
        "control": "data_source_field",
        "dataSourceFieldTypes": ["text"],
        "default": "",
        "ui": {
          "section": "data",
          "order": 2,
          "semanticRole": "title",
          "legacyKeys": ["labelField", "primaryField"]
        }
      },
      {
        "key": "startField",
        "label": "Start field",
        "description": "When the event begins. Required: events without a start cannot be placed.",
        "control": "data_source_field",
        "dataSourceFieldTypes": ["datetime", "date"],
        "default": "",
        "ui": {
          "section": "data",
          "order": 3,
          "semanticRole": "start",
          "legacyKeys": ["dateField", "timeField"]
        }
      },
      {
        "key": "endField",
        "label": "End field",
        "description": "When the event finishes. Drives the now treatment and ended removal.",
        "control": "data_source_field",
        "dataSourceFieldTypes": ["datetime", "date"],
        "default": "",
        "ui": {
          "section": "data",
          "order": 4,
          "semanticRole": "end",
          "legacyKeys": ["endDateField"]
        }
      },
      {
        "key": "locationField",
        "label": "Location field",
        "control": "data_source_field",
        "dataSourceFieldTypes": ["text"],
        "default": "",
        "ui": { "section": "data", "order": 5, "semanticRole": "location" }
      },
      {
        "key": "descriptionField",
        "label": "Description field",
        "control": "data_source_field",
        "dataSourceFieldTypes": ["text"],
        "default": "",
        "ui": {
          "section": "data",
          "order": 6,
          "semanticRole": "description",
          "legacyKeys": ["secondaryField"]
        }
      },
      {
        "key": "categoryField",
        "label": "Category field",
        "description": "Shown as a small tag beside the event.",
        "control": "data_source_field",
        "dataSourceFieldTypes": ["text"],
        "default": "",
        "ui": {
          "section": "data",
          "order": 7,
          "semanticRole": "category",
          "legacyKeys": ["section"]
        }
      },
      {
        "key": "heading",
        "label": "Heading",
        "control": "text",
        "maxLength": 120,
        "default": "",
        "ui": { "section": "content", "order": 1 }
      },
      {
        "key": "style",
        "label": "Style",
        "control": "select",
        "options": [
          { "value": "agenda", "label": "Agenda" },
          { "value": "now-next", "label": "Now and next" },
          { "value": "schedule-board", "label": "Schedule board" }
        ],
        "default": "agenda",
        "ui": { "section": "appearance", "order": 1, "styleCard": true }
      },
      {
        "key": "nowLabel",
        "label": "Now label",
        "control": "text",
        "maxLength": 80,
        "default": "Now",
        "ui": { "section": "content", "order": 6 }
      },
      {
        "key": "nextLabel",
        "label": "Next label",
        "control": "text",
        "maxLength": 80,
        "default": "Next",
        "ui": { "section": "content", "order": 7 }
      },
      {
        "key": "maximumItems",
        "label": "Maximum items",
        "control": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "ui": { "section": "content", "order": 8 }
      },
      {
        "key": "groupByDay",
        "label": "Group by day",
        "description": "Collect events under one heading per local day.",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 9 }
      },
      {
        "key": "hideEnded",
        "label": "Hide ended events",
        "description": "Remove events that already finished, reevaluated every minute from the Widget clock.",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 10 }
      },
      {
        "key": "upcomingCount",
        "label": "Upcoming events",
        "control": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 4,
        "ui": { "section": "content", "order": 11 }
      },
      {
        "key": "showCountdown",
        "label": "Show countdown",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 12 }
      },
      {
        "key": "showUpcomingTimeline",
        "label": "Show upcoming timeline",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 13 }
      },
      {
        "key": "emptyText",
        "label": "Empty message",
        "description": "Shown when nothing upcoming remains.",
        "control": "text",
        "maxLength": 200,
        "default": "",
        "ui": { "section": "content", "order": 14 }
      },
      {
        "key": "backgroundColor",
        "label": "Background color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 2 }
      },
      {
        "key": "foregroundColor",
        "label": "Text color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 3 }
      },
      {
        "key": "accentColor",
        "label": "Accent color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 4 }
      },
      {
        "key": "cardBackgroundColor",
        "label": "Schedule card background",
        "control": "color",
        "default": "",
        "ui": { "hidden": true }
      },
      {
        "key": "textScale",
        "label": "Text scale",
        "control": "integer",
        "minimum": 25,
        "maximum": 500,
        "ui": { "hidden": true }
      },
      {
        "key": "contentPadding",
        "label": "Content padding",
        "control": "integer",
        "minimum": 0,
        "maximum": 40,
        "ui": { "hidden": true }
      }
    ]
  },
  "defaultConfiguration": {
    "dataSourceId": "",
    "titleField": "",
    "startField": "",
    "endField": "",
    "locationField": "",
    "descriptionField": "",
    "categoryField": "",
    "heading": "",
    "style": "agenda",
    "nowLabel": "Now",
    "nextLabel": "Next",
    "maximumItems": 20,
    "upcomingCount": 4,
    "showCountdown": true,
    "showUpcomingTimeline": true,
    "groupByDay": true,
    "hideEnded": true,
    "emptyText": "",
    "backgroundColor": "",
    "foregroundColor": "",
    "accentColor": "",
    "cardBackgroundColor": ""
  },
  "presentationSchemaVersion": 1,
  "requiredCapabilities": {
    "layout.surface": 1,
    "layout.column": 1,
    "collection.repeat": 2,
    "collection.grouped_sections": 1,
    "content.text": 1,
    "binding.core": 2
  },
  "emptyStateBehavior": "text",
  "legacyEditor": true,
  "authoring": { "preview": { "time": true } },
  "deprecation": {},
  "component": {
    "type": "tilecast.agenda",
    "version": 1,
    "tagName": "tc-widget-agenda",
    "entrypoint": "./runtime/index.ts",
    "configTemplate": {
      "dataSourceId": { "$config": "dataSourceId", "default": "" },
      "titleField": {
        "$config": "titleField",
        "default": {
          "$config": "labelField",
          "default": { "$config": "primaryField", "default": "" }
        }
      },
      "startField": {
        "$config": "startField",
        "default": {
          "$config": "dateField",
          "default": { "$config": "timeField", "default": "" }
        }
      },
      "endField": { "$config": "endField", "default": "" },
      "locationField": { "$config": "locationField", "default": "" },
      "descriptionField": {
        "$config": "descriptionField",
        "default": { "$config": "secondaryField", "default": "" }
      },
      "categoryField": { "$config": "categoryField", "default": "" },
      "heading": { "$config": "heading", "default": "" },
      "style": { "$config": "style", "default": "agenda" },
      "nowLabel": { "$config": "nowLabel", "default": "Now" },
      "nextLabel": { "$config": "nextLabel", "default": "Next" },
      "maximumItems": { "$config": "maximumItems", "default": 20 },
      "upcomingCount": { "$config": "upcomingCount", "default": 4 },
      "showCountdown": { "$config": "showCountdown", "default": true },
      "showUpcomingTimeline": {
        "$config": "showUpcomingTimeline",
        "default": true
      },
      "groupByDay": { "$config": "groupByDay", "default": true },
      "hideEnded": { "$config": "hideEnded", "default": true },
      "emptyText": {
        "$config": "emptyText",
        "default": { "$config": "emptyState", "default": "" }
      },
      "background": { "$config": "backgroundColor", "default": "" },
      "foreground": { "$config": "foregroundColor", "default": "" },
      "accent": { "$config": "accentColor", "default": "" },
      "cardBackground": { "$config": "cardBackgroundColor", "default": "" }
    },
    "dataSourceFields": ["dataSourceId"],
    "empty": "skip-eligible"
  },
  "compatibility": {
    "fallback": "legacy"
  }
}
