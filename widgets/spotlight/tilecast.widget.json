{
  "$schema": "../../packages/widget-sdk/schema/tilecast-widget.schema.json",
  "apiVersion": 1,
  "id": "spotlight",
  "version": 1,
  "name": "Spotlight",
  "description": "Feature one record with optional managed artwork.",
  "category": "Data display",
  "icon": "spotlight",
  "keywords": ["spotlight", "feature", "hero", "record"],
  "runtime": "native",
  "configurationSchema": {
    "fields": [
      {
        "key": "dataSourceId",
        "label": "Data Source",
        "description": "The records source holding the featured record.",
        "control": "data_source",
        "acceptedDataSourceKinds": ["records"],
        "default": "",
        "ui": { "section": "data", "order": 1 }
      },
      {
        "key": "titleField",
        "label": "Title field",
        "control": "data_source_field",
        "required": true,
        "dataSourceKey": "dataSourceId",
        "ui": { "section": "data", "order": 2 }
      },
      {
        "key": "subtitleField",
        "label": "Subtitle field",
        "control": "data_source_field",
        "dataSourceKey": "dataSourceId",
        "default": "",
        "ui": { "section": "data", "order": 3 }
      },
      {
        "key": "bodyField",
        "label": "Body field",
        "control": "data_source_field",
        "dataSourceKey": "dataSourceId",
        "default": "",
        "ui": { "section": "data", "order": 4 }
      },
      {
        "key": "badgeField",
        "label": "Badge field",
        "description": "Optional. A short status shown as a badge.",
        "control": "data_source_field",
        "dataSourceKey": "dataSourceId",
        "default": "",
        "ui": { "section": "data", "order": 5 }
      },
      {
        "key": "metadataField",
        "label": "Metadata field",
        "description": "Optional. A date or detail shown with the title.",
        "control": "data_source_field",
        "dataSourceKey": "dataSourceId",
        "dataSourceFieldTypes": [
          "text",
          "number",
          "integer",
          "currency",
          "percent",
          "boolean",
          "date",
          "datetime"
        ],
        "default": "",
        "ui": { "section": "data", "order": 6 }
      },
      {
        "key": "imageAssetId",
        "label": "Artwork",
        "description": "Optional. An uploaded image from the Media library.",
        "control": "media_asset",
        "mediaTypes": ["image"],
        "default": "",
        "ui": { "section": "content", "order": 1 }
      },
      {
        "key": "emptyText",
        "label": "Empty message",
        "control": "text",
        "maxLength": 200,
        "default": "",
        "ui": { "section": "content", "order": 2 }
      },
      {
        "key": "backgroundColor",
        "label": "Background color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 1 }
      },
      {
        "key": "foregroundColor",
        "label": "Text color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 2 }
      },
      {
        "key": "textScale",
        "label": "Text scale",
        "control": "integer",
        "minimum": 25,
        "maximum": 500,
        "ui": { "hidden": true }
      },
      {
        "key": "contentPadding",
        "label": "Content padding",
        "control": "integer",
        "minimum": 0,
        "maximum": 40,
        "ui": { "hidden": true }
      }
    ]
  },
  "defaultConfiguration": {
    "dataSourceId": "",
    "titleField": "",
    "subtitleField": "",
    "bodyField": "",
    "badgeField": "",
    "metadataField": "",
    "imageAssetId": "",
    "emptyText": "",
    "backgroundColor": "",
    "foregroundColor": ""
  },
  "presentationSchemaVersion": 1,
  "requiredCapabilities": {
    "layout.surface": 1,
    "layout.column": 1,
    "content.text": 1,
    "content.badge": 1,
    "binding.core": 2
  },
  "emptyStateBehavior": "text",
  "legacyEditor": true,
  "deprecation": {},
  "component": {
    "type": "tilecast.spotlight",
    "version": 1,
    "tagName": "tc-widget-spotlight",
    "entrypoint": "./runtime/index.ts",
    "configTemplate": {
      "dataSourceId": { "$config": "dataSourceId", "default": "" },
      "titleField": { "$config": "titleField", "default": "" },
      "subtitleField": { "$config": "subtitleField", "default": "" },
      "bodyField": { "$config": "bodyField", "default": "" },
      "badgeField": { "$config": "badgeField", "default": "" },
      "metadataField": {
        "$config": "metadataField",
        "default": { "$config": "dateField", "default": "" }
      },
      "image": {
        "assetId": { "$config": "imageAssetId", "default": "" },
        "variantId": { "$config": "imageVariantId", "default": "" }
      },
      "emptyText": {
        "$config": "emptyText",
        "default": { "$config": "emptyState", "default": "" }
      },
      "background": { "$config": "backgroundColor", "default": "" },
      "foreground": { "$config": "foregroundColor", "default": "" }
    },
    "dataSourceFields": ["dataSourceId"],
    "empty": "skip-eligible"
  },
  "compatibility": { "fallback": "legacy" }
}
