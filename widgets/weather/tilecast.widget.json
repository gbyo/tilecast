{
  "$schema": "../../packages/widget-sdk/schema/tilecast-widget.schema.json",
  "apiVersion": 1,
  "id": "weather",
  "version": 1,
  "configVersion": 2,
  "name": "Weather",
  "description": "Show current conditions and the multi-day forecast.",
  "category": "Information",
  "icon": "cloud_sun",
  "runtime": "native",
  "configurationSchema": {
    "fields": [
      {
        "key": "dataSourceId",
        "label": "Data Source",
        "description": "The Weather source this Widget reads.",
        "control": "data_source",
        "acceptedDataSourceKinds": ["records"],
        "default": "",
        "ui": { "section": "data", "order": 1 }
      },
      {
        "key": "showLocation",
        "label": "Show location",
        "control": "boolean",
        "default": true,
        "ui": {
          "section": "content",
          "order": 2,
          "visibleWhen": { "key": "showCurrent", "equals": true }
        }
      },
      {
        "key": "showCurrent",
        "label": "Show current conditions",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 1 }
      },
      {
        "key": "showCondition",
        "label": "Show condition text",
        "description": "Show the current condition label, such as Partly Cloudy.",
        "control": "boolean",
        "default": true,
        "ui": {
          "section": "content",
          "order": 3,
          "visibleWhen": { "key": "showCurrent", "equals": true }
        }
      },
      {
        "key": "showIcons",
        "label": "Show weather icons",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 4 }
      },
      {
        "key": "showTemperatureDecimals",
        "label": "Show decimal temperatures",
        "description": "Turn this off to round temperatures to whole degrees.",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 5 }
      },
      {
        "key": "showTemperatureUnit",
        "label": "Show temperature unit",
        "description": "Show the °C or °F unit beside current, high and low temperatures.",
        "control": "boolean",
        "default": true,
        "ui": { "section": "content", "order": 6 }
      },
      {
        "key": "forecastDays",
        "label": "Forecast days",
        "control": "integer",
        "minimum": 0,
        "maximum": 7,
        "default": 5,
        "ui": { "section": "content", "order": 11, "slider": true }
      },
      {
        "key": "showForecastDay",
        "label": "Show forecast day",
        "description": "Show the weekday above each forecast.",
        "control": "boolean",
        "default": true,
        "ui": {
          "section": "content",
          "order": 12,
          "visibleWhen": { "key": "forecastDays", "notEquals": 0 }
        }
      },
      {
        "key": "showForecastCondition",
        "label": "Show forecast condition text",
        "description": "Show the condition label for each forecast day.",
        "control": "boolean",
        "default": false,
        "ui": {
          "section": "content",
          "order": 13,
          "visibleWhen": { "key": "forecastDays", "notEquals": 0 },
          "advanced": true
        }
      },
      {
        "key": "showForecastHighLow",
        "label": "Show forecast high and low",
        "control": "boolean",
        "default": true,
        "ui": {
          "section": "content",
          "order": 14,
          "visibleWhen": { "key": "forecastDays", "notEquals": 0 }
        }
      },
      {
        "key": "showHumidity",
        "label": "Show humidity",
        "control": "boolean",
        "default": true,
        "ui": {
          "section": "content",
          "order": 7,
          "visibleWhen": { "key": "showCurrent", "equals": true }
        }
      },
      {
        "key": "showWind",
        "label": "Show wind",
        "control": "boolean",
        "default": true,
        "ui": {
          "section": "content",
          "order": 8,
          "visibleWhen": { "key": "showCurrent", "equals": true }
        }
      },
      {
        "key": "showPrecipitation",
        "label": "Show precipitation",
        "control": "boolean",
        "default": true,
        "ui": {
          "section": "content",
          "order": 9,
          "visibleWhen": { "key": "showCurrent", "equals": true }
        }
      },
      {
        "key": "showDetailLabels",
        "label": "Label weather details",
        "description": "Prefix humidity, wind and precipitation values with their field labels.",
        "control": "boolean",
        "default": false,
        "ui": {
          "section": "content",
          "order": 10,
          "visibleWhen": { "key": "showCurrent", "equals": true },
          "advanced": true
        }
      },
      {
        "key": "emptyText",
        "label": "Empty message",
        "description": "Shown when the forecast has no usable records.",
        "control": "text",
        "maxLength": 200,
        "default": "",
        "ui": { "section": "content", "order": 15, "advanced": true }
      },
      {
        "key": "backgroundColor",
        "label": "Background color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 1 }
      },
      {
        "key": "foregroundColor",
        "label": "Text color",
        "control": "color",
        "default": "",
        "ui": { "section": "appearance", "order": 2 }
      },
      {
        "key": "textScale",
        "label": "Text scale",
        "control": "integer",
        "minimum": 25,
        "maximum": 500,
        "ui": { "hidden": true }
      },
      {
        "key": "contentPadding",
        "label": "Content padding",
        "control": "integer",
        "minimum": 0,
        "maximum": 40,
        "ui": { "hidden": true }
      }
    ]
  },
  "defaultConfiguration": {
    "dataSourceId": "",
    "showCurrent": true,
    "showLocation": true,
    "showCondition": true,
    "showIcons": true,
    "showTemperatureDecimals": true,
    "showTemperatureUnit": true,
    "showHumidity": true,
    "showWind": true,
    "showPrecipitation": true,
    "showDetailLabels": false,
    "forecastDays": 5,
    "showForecastDay": true,
    "showForecastCondition": false,
    "showForecastHighLow": true,
    "emptyText": "",
    "backgroundColor": "",
    "foregroundColor": ""
  },
  "presentationSchemaVersion": 1,
  "requiredCapabilities": {
    "layout.surface": 1,
    "layout.column": 1,
    "content.text": 1,
    "binding.core": 2
  },
  "emptyStateBehavior": "text",
  "legacyEditor": true,
  "deprecation": {},
  "component": {
    "type": "tilecast.weather",
    "version": 2,
    "tagName": "tc-widget-weather",
    "entrypoint": "./runtime/index.ts",
    "configTemplate": {
      "dataSourceId": { "$config": "dataSourceId", "default": "" },
      "showLocation": { "$config": "showLocation", "default": true },
      "showCurrent": { "$config": "showCurrent", "default": true },
      "showCondition": { "$config": "showCondition", "default": true },
      "showIcons": { "$config": "showIcons", "default": true },
      "showTemperatureDecimals": {
        "$config": "showTemperatureDecimals",
        "default": true
      },
      "showTemperatureUnit": {
        "$config": "showTemperatureUnit",
        "default": true
      },
      "forecastDays": { "$config": "forecastDays", "default": 5 },
      "showForecastDay": { "$config": "showForecastDay", "default": true },
      "showForecastCondition": {
        "$config": "showForecastCondition",
        "default": false
      },
      "showForecastHighLow": {
        "$config": "showForecastHighLow",
        "default": true
      },
      "showHumidity": { "$config": "showHumidity", "default": true },
      "showWind": { "$config": "showWind", "default": true },
      "showPrecipitation": { "$config": "showPrecipitation", "default": true },
      "showDetailLabels": { "$config": "showDetailLabels", "default": false },
      "emptyText": {
        "$config": "emptyText",
        "default": { "$config": "emptyState", "default": "" }
      },
      "background": { "$config": "backgroundColor", "default": "" },
      "foreground": { "$config": "foregroundColor", "default": "" }
    },
    "dataSourceFields": ["dataSourceId"],
    "empty": "skip-eligible"
  },
  "compatibility": {
    "fallback": "legacy"
  }
}
