{
  "$schema": "../../packages/widget-sdk/schema/tilecast-widget.schema.json",
  "apiVersion": 1,
  "id": "clock",
  "version": 1,
  "name": "Clock",
  "description": "Show live local time in a configured timezone.",
  "category": "Essentials",
  "icon": "clock",
  "runtime": "native",
  "configurationSchema": {
    "fields": [
      {
        "key": "timezone",
        "label": "Timezone",
        "description": "Leave blank to use the organization timezone, or enter any valid IANA timezone ID.",
        "control": "timezone",
        "default": "",
        "ui": { "section": "content", "order": 1 }
      },
      {
        "key": "format",
        "label": "Time format",
        "description": "Use the organization setting, or force a 12- or 24-hour clock.",
        "control": "select",
        "options": [
          { "value": "locale", "label": "Use organization setting" },
          { "value": "12", "label": "12-hour" },
          { "value": "24", "label": "24-hour" }
        ],
        "default": "locale",
        "ui": { "section": "content", "order": 2 }
      },
      {
        "key": "showSeconds",
        "label": "Show seconds",
        "control": "boolean",
        "default": false,
        "ui": { "section": "content", "order": 3 }
      },
      {
        "key": "style",
        "label": "Style",
        "description": "Standard shows the time with an optional date. Minimal shows the time alone, as large as possible. Analog shows a dial with the digital time beside it. Screens whose Player predates these styles show the time alone.",
        "control": "select",
        "options": [
          { "value": "standard", "label": "Standard" },
          { "value": "minimal", "label": "Minimal" },
          { "value": "analog", "label": "Analog" }
        ],
        "default": "standard",
        "ui": { "section": "appearance", "order": 1, "styleCard": true }
      },
      {
        "key": "showDate",
        "label": "Show date",
        "description": "Minimal style always shows the time alone.",
        "control": "boolean",
        "default": false,
        "ui": {
          "section": "appearance",
          "order": 2,
          "visibleWhen": { "key": "style", "notEquals": "minimal" }
        }
      },
      {
        "key": "backgroundColor",
        "label": "Background color",
        "control": "color",
        "default": "#0E141B",
        "ui": { "section": "appearance", "order": 3 }
      },
      {
        "key": "foregroundColor",
        "label": "Text and accent color",
        "control": "color",
        "default": "#F5F7FA",
        "ui": { "section": "appearance", "order": 4 }
      }
    ]
  },
  "defaultConfiguration": {
    "timezone": "",
    "format": "locale",
    "showSeconds": false,
    "style": "standard",
    "showDate": false,
    "backgroundColor": "#0E141B",
    "foregroundColor": "#F5F7FA"
  },
  "presentationSchemaVersion": 1,
  "requiredCapabilities": {
    "layout.surface": 1,
    "content.text": 1,
    "binding.core": 1
  },
  "emptyStateBehavior": "text",
  "legacyEditor": true,
  "deprecation": {},
  "component": {
    "type": "tilecast.clock",
    "version": 1,
    "tagName": "tc-widget-clock",
    "entrypoint": "./runtime/index.ts",
    "configTemplate": {
      "timeZone": { "$config": "timezone", "default": "" },
      "format": { "$config": "format", "default": "locale" },
      "showSeconds": { "$config": "showSeconds", "default": false },
      "style": { "$config": "style", "default": "standard" },
      "showDate": { "$config": "showDate", "default": false },
      "background": { "$config": "backgroundColor", "default": "" },
      "foreground": { "$config": "foregroundColor", "default": "" }
    },
    "empty": "render"
  },
  "compatibility": {
    "fallback": "legacy"
  }
}
