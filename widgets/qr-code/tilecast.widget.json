{
  "$schema": "../../packages/widget-sdk/schema/tilecast-widget.schema.json",
  "apiVersion": 1,
  "id": "qr-code",
  "version": 1,
  "name": "QR Code",
  "description": "Show a scannable code with an optional heading and instruction.",
  "category": "Essentials",
  "icon": "qr_code",
  "runtime": "native",
  "configurationSchema": {
    "fields": [
      {
        "key": "payload",
        "label": "Link or text",
        "description": "What the code opens or says when scanned. Keep it short so the code stays readable from a distance.",
        "control": "text",
        "maxLength": 2048,
        "default": "",
        "ui": { "section": "content", "order": 1 }
      },
      {
        "key": "heading",
        "label": "Heading",
        "description": "Tells viewers why they should scan.",
        "control": "text",
        "maxLength": 120,
        "default": "",
        "ui": {
          "section": "content",
          "order": 2,
          "visibleWhen": { "key": "style", "notEquals": "code" }
        }
      },
      {
        "key": "instruction",
        "label": "Instruction",
        "control": "multiline_text",
        "maxLength": 300,
        "default": "",
        "ui": {
          "section": "content",
          "order": 3,
          "visibleWhen": { "key": "style", "equals": "standard" }
        }
      },
      {
        "key": "shortLabel",
        "label": "Short label",
        "description": "A short line under the code, such as the domain.",
        "control": "text",
        "maxLength": 60,
        "default": "",
        "ui": {
          "section": "content",
          "order": 4,
          "visibleWhen": { "key": "style", "equals": "standard" }
        }
      },
      {
        "key": "style",
        "label": "Style",
        "description": "Standard pairs the code with its text. Code only shows the code alone for small zones.",
        "control": "select",
        "options": [
          { "value": "standard", "label": "Standard" },
          { "value": "code", "label": "Code only" }
        ],
        "default": "standard",
        "ui": { "section": "appearance", "order": 1, "styleCard": true }
      },
      {
        "key": "backgroundColor",
        "label": "Background color",
        "description": "Keep it light so the code scans reliably.",
        "control": "color",
        "default": "#FFFFFF",
        "ui": { "section": "appearance", "order": 2 }
      },
      {
        "key": "foregroundColor",
        "label": "Code color",
        "description": "Keep it dark so the code scans reliably.",
        "control": "color",
        "default": "#101418",
        "ui": { "section": "appearance", "order": 3 }
      }
    ]
  },
  "defaultConfiguration": {
    "payload": "",
    "heading": "",
    "instruction": "",
    "shortLabel": "",
    "style": "standard",
    "backgroundColor": "#FFFFFF",
    "foregroundColor": "#101418"
  },
  "presentationSchemaVersion": 1,
  "requiredCapabilities": {
    "layout.surface": 1,
    "content.qr_code": 1,
    "binding.core": 1
  },
  "emptyStateBehavior": "text",
  "legacyEditor": true,
  "deprecation": {},
  "component": {
    "type": "tilecast.qr-code",
    "version": 1,
    "tagName": "tc-widget-qr-code",
    "entrypoint": "./runtime/index.ts",
    "configTemplate": {
      "payload": { "$config": "payload", "default": "" },
      "heading": { "$config": "heading", "default": "" },
      "instruction": { "$config": "instruction", "default": "" },
      "shortLabel": { "$config": "shortLabel", "default": "" },
      "style": { "$config": "style", "default": "standard" },
      "background": { "$config": "backgroundColor", "default": "#FFFFFF" },
      "foreground": { "$config": "foregroundColor", "default": "#101418" }
    },
    "empty": "render"
  },
  "compatibility": {
    "fallback": "none"
  }
}
