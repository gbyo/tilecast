---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
// Captures use 2× pixel density; retain their original CSS dimensions while
// letting Astro generate responsive variants up to the full source resolution.
const width = src.width / 2;
const height = src.height / 2;
---

<figure>
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    layout="constrained"
    priority={priority}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 1.5rem 0;
  }
  img {
    display: block;
    height: auto;
    max-width: 100%;
    border: 1px solid var(--tc-border-default);
    border-radius: var(--tc-radius-panel);
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--tc-text-secondary);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
</style>
