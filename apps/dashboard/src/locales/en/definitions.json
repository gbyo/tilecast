{
  "event-scroller": {
    "fields": {
      "dataSourceId": {
        "label": "Data Source",
        "description": "Connect a calendar or another records source."
      },
      "titleField": {
        "label": "Title field"
      },
      "startField": {
        "label": "Start field"
      },
      "endField": {
        "label": "End field"
      },
      "locationField": {
        "label": "Location field"
      },
      "categoryField": {
        "label": "Category field"
      },
      "heading": {
        "label": "Heading"
      },
      "maximumItems": {
        "label": "Maximum events"
      },
      "hideEnded": {
        "label": "Hide past events",
        "description": "Ended events leave the board using the Player clock. Events without an end stay through their local day."
      },
      "showWeekday": {
        "label": "Show weekday"
      },
      "showDate": {
        "label": "Show date"
      },
      "showTime": {
        "label": "Show time"
      },
      "showLocation": {
        "label": "Show location"
      },
      "showCategory": {
        "label": "Show category"
      },
      "showDividers": {
        "label": "Show dividers"
      },
      "dateStyle": {
        "label": "Date style",
        "options": {
          "short": "Short month and day",
          "day": "Day of month",
          "numeric": "Numeric month and day"
        }
      },
      "emptyText": {
        "label": "Empty message",
        "description": "Leave blank to use the standard empty message."
      },
      "flow": {
        "label": "Flow",
        "options": {
          "auto": "Auto",
          "vertical": "Vertical",
          "horizontal": "Horizontal"
        }
      },
      "verticalDirection": {
        "label": "Vertical direction",
        "options": {
          "up": "Up",
          "down": "Down"
        }
      },
      "horizontalDirection": {
        "label": "Horizontal direction",
        "options": {
          "left": "Left",
          "right": "Right"
        }
      },
      "scrollSpeed": {
        "label": "Scroll speed",
        "description": "1 is slow, 10 is fast. The reading pace stays consistent as you add events."
      },
      "scrolling": {
        "label": "Scrolling enabled"
      },
      "density": {
        "label": "Density",
        "options": {
          "compact": "Compact",
          "comfortable": "Comfortable",
          "spacious": "Spacious"
        }
      },
      "backgroundColor": {
        "label": "Background"
      },
      "foregroundColor": {
        "label": "Foreground"
      },
      "accentColor": {
        "label": "Accent"
      }
    }
  },
  "canva": {
    "fields": {
      "canvaUrl": {
        "label": "Canva design link",
        "description": "Paste a public design view link, Smart embed link, iframe src URL, or canva.link short link. Publish a public embed in Canva first."
      },
      "refreshIntervalSeconds": { "label": "Reload interval" }
    }
  },
  "website": {
    "fields": {
      "url": {
        "label": "Web address",
        "description": "The public page to show. Use HTTPS; plain HTTP works only for private addresses when this installation allows it."
      },
      "backgroundColor": {
        "label": "Background color",
        "description": "Shown behind the page while it loads."
      },
      "zoomPercent": {
        "label": "Zoom (%)"
      },
      "scrollX": {
        "label": "Horizontal scroll (px)"
      },
      "scrollY": {
        "label": "Vertical scroll (px)"
      },
      "reloadPolicy": {
        "label": "Reload",
        "options": {
          "load_once": "Load once while active",
          "on_each_activation": "Reload each time it appears",
          "interval": "Reload on an interval"
        }
      },
      "refreshIntervalSeconds": {
        "label": "Reload every (seconds)"
      },
      "failureBehavior": {
        "label": "If the page cannot load",
        "options": {
          "placeholder": "Show the Tilecast placeholder",
          "last_success": "Keep the last page that loaded",
          "fallback_image": "Show a fallback image",
          "skip": "Skip this item"
        }
      },
      "fallbackImageAssetId": {
        "label": "Fallback image"
      },
      "loadTimeoutSeconds": {
        "label": "Load timeout (seconds)"
      },
      "allowedHosts": {
        "label": "Allowed hosts",
        "description": "Exact host names the page may navigate to. The page's own host is always allowed. This limits top-level navigation, not every third-party resource."
      },
      "javascriptEnabled": {
        "label": "Run JavaScript"
      },
      "domStorageEnabled": {
        "label": "Allow DOM storage"
      },
      "cookiePolicy": {
        "label": "Cookies",
        "options": {
          "disabled": "Disabled",
          "first_party": "First-party only",
          "first_and_third_party": "First- and third-party"
        }
      },
      "customUserAgent": {
        "label": "Custom user agent",
        "description": "Leave blank for the Player's standard user agent. Overrides can break sites."
      }
    }
  },
  "youtube": {
    "fields": {
      "url": {
        "label": "YouTube video or playlist URL",
        "description": "Tilecast detects whether this is a video or a playlist. No YouTube API key is required."
      },
      "startSeconds": {
        "label": "Start at (seconds)"
      },
      "endSeconds": {
        "label": "End at (seconds)",
        "description": "Leave blank to play to the end."
      },
      "captions": {
        "label": "Show captions"
      },
      "captionLanguage": {
        "label": "Caption language",
        "description": "A language code such as en or es. Leave blank for YouTube's default."
      },
      "muted": {
        "label": "Mute audio"
      },
      "volume": {
        "label": "Volume (%)"
      },
      "loop": {
        "label": "Loop playback"
      },
      "controls": {
        "label": "Show YouTube controls"
      },
      "playlistPlaybackMode": {
        "label": "Playlist item length",
        "options": {
          "until_end": "Play until the video ends",
          "fixed_duration": "Play for a fixed duration"
        }
      },
      "fixedDurationSeconds": {
        "label": "Fixed duration (seconds)"
      },
      "failureBehavior": {
        "label": "If the video cannot play",
        "options": {
          "placeholder": "Show the Tilecast placeholder",
          "fallback_image": "Show a fallback image",
          "skip": "Skip this item"
        }
      },
      "fallbackImageAssetId": {
        "label": "Fallback image"
      }
    }
  }
}
