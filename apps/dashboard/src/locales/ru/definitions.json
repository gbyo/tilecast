          "first_and_third_party": "Собственные и сторонние"
        }
      },
      "customUserAgent": {
        "label": "Пользовательский User-Agent",
        "description": "Оставьте пустым для стандартного User-Agent проигрывателя. Изменение может нарушить работу сайтов."
      }
    }
