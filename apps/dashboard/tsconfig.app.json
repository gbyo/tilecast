{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@tilecast/player-runtime/zone-playback": [
        "../../packages/player-runtime/src/engine/zone-playback.ts"
      ],
      "@tilecast/player-runtime/projection": [
        "../../packages/player-runtime/src/compat/projection/index.ts"
      ],
      "@tilecast/player-runtime/host-contract": [
        "../../packages/player-runtime/src/host/contract.ts"
      ],
      "@/*": ["./src/*"],
      "@tilecast/studio": ["./src/plugin-host/kit.ts"],
      "@tilecast/studio/ui/*": ["./src/components/ui/*"],
      "@tilecast/studio/testing": ["./src/plugin-host/testing.tsx"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@hookform/resolvers/*": ["./node_modules/@hookform/resolvers/*"]
    },
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "../../plugins/*/studio"]
}
