{
  "name": "@gibsonmb71/tilecast-player-linux",
  "version": "0.17.0",
  "license": "AGPL-3.0-only",
  "description": "Tilecast Player for Linux kiosk devices",
  "author": "Gibsonmb71",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --linux --publish never",
    "prebuild": "npm run build --prefix ../../packages/player-runtime"
  },
  "dependencies": {
    "@tilecast/player-runtime": "0.1.0",
    "bonjour-service": "^1.4.4",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "electron@39.8.5": true
  },
  "files": [
    "dist/**"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gibsonmb71/tilecast.git",
    "directory": "apps/player-linux"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
