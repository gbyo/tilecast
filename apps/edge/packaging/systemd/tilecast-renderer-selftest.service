# The renderer half of the release self-test (M7 migration step 3): the
# installed renderer, WPE WebKit, GStreamer and the Player Runtime, drawing
# the built-in fixture off screen while the legacy player keeps the display.
# The DRM output itself is checked by tilecast-renderer-probe.service before
# the cutover and proven on screen by the migration's settlement.
[Unit]
Description=Tilecast WPE renderer for the release self-test
Documentation=https://github.com/gbyo/tilecast/blob/main/apps/edge/packaging/README.md

[Service]
Type=simple
User=tilecast
Group=tilecast
SupplementaryGroups=video render
ExecStart=/opt/tilecast-edge/current/bin/tilecast-renderer-wpe --platform=headless --socket=/run/tilecast-edge-selftest/edge.sock --media-socket=/run/tilecast-edge-selftest/media.sock --runtime-dir=/opt/tilecast-edge/current/share/tilecast/renderer-web --gst-plugin-dir=/opt/tilecast-edge/current/lib/gstreamer-1.0
Restart=no
TimeoutStopSec=10s
# The renderer's own account of why it ended (a loader error, a crash) for the
# migrator's attempt record; it is not written to the journal.
StandardError=truncate:/run/tilecast-edge-migrate/selftest-renderer.err
# Same layout as tilecast-renderer.service, in its own tree: HOME must not
# resolve into the hidden /var/lib/tilecast-edge.
CacheDirectory=tilecast-renderer-selftest tilecast-renderer-selftest/home tilecast-renderer-selftest/config tilecast-renderer-selftest/data
CacheDirectoryMode=0700
Environment=HOME=/var/cache/tilecast-renderer-selftest/home
Environment=XDG_CONFIG_HOME=/var/cache/tilecast-renderer-selftest/config
Environment=XDG_CACHE_HOME=/var/cache/tilecast-renderer-selftest
Environment=XDG_DATA_HOME=/var/cache/tilecast-renderer-selftest/data
UMask=0077
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
InaccessiblePaths=-/var/lib/tilecast-edge
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
# No ProtectKernelTunables=, ProtectKernelLogs= or RestrictSUIDSGID=: see
# tilecast-renderer.service.
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
