# Tilecast WPE renderer for dedicated signage (WPE_PLATFORM=drm).
# Development machines with a compositor run the renderer with
# --platform=wayland from the desktop session instead.
[Unit]
Description=Tilecast WPE renderer
Documentation=https://github.com/gbyo/tilecast/blob/main/docs/tilecast-edge.md
# The renderer is disposable and independent: it waits for tilecastd's socket
# and reconnects, and a renderer crash never restarts the daemon. It starts
# after the web helper so remote surfaces exist before the runtime binds
# them; the helper is only ordered, never required, so the renderer still
# starts when the helper is masked or failing.
After=tilecast-edge.service tilecast-web-renderer.service systemd-user-sessions.service
Wants=tilecast-edge.service tilecast-web-renderer.service
Conflicts=getty@tty1.service
# A latched renderer is a dark screen until a site visit, so restarts are
# never rate-limited into the failed state (same rule as the legacy unit).
StartLimitIntervalSec=0

[Service]
Type=simple
User=tilecast
Group=tilecast
# tilecast-web joins the helper's runtime directory and sockets
# (/run/tilecast-web, 0750 tilecast-web:tilecast-web with 0660 sockets) to
# the trusted renderer and nothing else. The helper's persistent website
# profiles stay 0700 tilecast-web, so group membership does not let the
# renderer read web storage (threat review §3-§5).
SupplementaryGroups=video render input audio tilecast-web
ExecStart=/opt/tilecast-edge/current/bin/tilecast-renderer-wpe --platform=drm --socket=/run/tilecast-edge/edge.sock --media-socket=/run/tilecast-edge/media.sock --runtime-dir=/opt/tilecast-edge/current/share/tilecast/renderer-web --gst-plugin-dir=/opt/tilecast-edge/current/lib/gstreamer-1.0
Restart=always
RestartSec=2
TimeoutStopSec=10s
# Own the VT so DRM master is available without a desktop session.
TTYPath=/dev/tty1
StandardInput=tty-force
TTYReset=yes
TTYVHangup=yes

# The renderer's whole writable world. The account's home directory is
# /var/lib/tilecast-edge, which this unit hides, so HOME and the XDG
# directories name renderer-owned cache paths instead; a library that looks
# in $HOME/.config (WebKit's sandbox checks $HOME/.config/pulse) must not
# resolve into the daemon's state. systemd creates and owns the directories.
CacheDirectory=tilecast-renderer tilecast-renderer/home tilecast-renderer/config tilecast-renderer/data
CacheDirectoryMode=0700
Environment=HOME=/var/cache/tilecast-renderer/home
Environment=XDG_CONFIG_HOME=/var/cache/tilecast-renderer/config
Environment=XDG_CACHE_HOME=/var/cache/tilecast-renderer
Environment=XDG_DATA_HOME=/var/cache/tilecast-renderer/data
UMask=0077

# Filesystem isolation: the renderer shares the tilecast account with the
# daemon, so the unit is the boundary. It sees none of the daemon's state:
# not the identity directory, the state database or the content store. Media
# arrives only as daemon-granted capabilities read over media.sock
# (docs/tilecast-edge.md §10.3).
ProtectHome=yes
ProtectSystem=strict
InaccessiblePaths=-/var/lib/tilecast-edge
# The Presentation Network helper's socket. The account may belong to its
# tilecast-network group, and the renderer inherits the account's groups.
# An empty private mount hides a helper started after this renderer starts.
TemporaryFileSystem=/run/tilecast:ro,mode=0000
# The update helper's socket: only tilecastd may ask for an update operation
# (docs/tilecast-edge-update-threat-review.md).
InaccessiblePaths=-/run/tilecast-edge-update
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
# Three directives are deliberately absent, because each one stops WebKit's
# own bubblewrap sandbox from starting its child processes:
#   ProtectKernelTunables=, ProtectKernelLogs=  they mount read-only or empty
#       files over /proc, and the kernel then refuses the fresh /proc that
#       bubblewrap mounts ("bwrap: Can't mount proc").
#   RestrictSUIDSGID=  its seccomp filter makes openat2() fail with ENOSYS,
#       and bubblewrap 0.12 and later does not fall back ("Can't open
#       source /: Function not implemented").
# Keeping them would force WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS, which is
# never acceptable here. What they gave holds without them: the unit runs as
# an ordinary account with no capability and NoNewPrivileges=yes, so it cannot
# write /proc/sys or /sys, read the kernel log, or use a setuid file, and its
# writable directories are private 0700 trees
# (docs/records/edge/0.2.1-sandbox-review.md).
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
