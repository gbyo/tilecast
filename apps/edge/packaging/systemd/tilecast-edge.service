# Tilecast Edge daemon (tilecastd). See apps/edge/packaging/README.md.
[Unit]
Description=Tilecast Edge daemon
Documentation=https://github.com/gbyo/tilecast/blob/main/docs/tilecast-edge.md
After=network-online.target time-sync.target
Wants=network-online.target
# One owner of the device credential: the legacy Electron player unit must be
# disabled before this unit is enabled (the Edge installer does both).

[Service]
Type=notify
NotifyAccess=main
User=tilecast
Group=tilecast
ExecStartPre=/opt/tilecast-edge/current/bin/tilecastd check-config
ExecStart=/opt/tilecast-edge/current/bin/tilecastd run
Restart=always
RestartSec=2
WatchdogSec=30s
TimeoutStartSec=60s
TimeoutStopSec=20s

StateDirectory=tilecast-edge
StateDirectoryMode=0700
RuntimeDirectory=tilecast-edge
RuntimeDirectoryMode=0750
# The socket directory survives daemon restarts so a waiting renderer can
# reconnect to the same path.
RuntimeDirectoryPreserve=restart
UMask=0077

# Hardening. The daemon needs no device access yet; CEC, DDC/I2C and input
# providers will add explicit DeviceAllow= entries and groups when they land,
# after a capability-matrix test (RFC §27.1). The legacy home directory is
# read only by the one-time importer, which the installer runs separately.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
