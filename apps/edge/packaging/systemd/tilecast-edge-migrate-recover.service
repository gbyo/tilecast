# Boot-time recovery for an interrupted migration (M7). Enabled only while an
# attempt is in its cutover or settlement; the migrator disables it when the
# attempt ends. It runs before Edge and the display manager, so after a power
# loss during settlement the machine returns to the legacy player instead of
# starting a stack that was never accepted. While it is enabled, the Edge
# units also require it (the migrator adds that dependency through systemd,
# and disabling this unit removes it), so if the recovery cannot run, the
# unaccepted Edge does not start either.
[Unit]
Description=Tilecast Edge migration recovery
Documentation=https://github.com/gbyo/tilecast/blob/main/apps/edge/packaging/README.md
ConditionPathExists=/var/lib/tilecast-edge-migrate/state.json
StartLimitIntervalSec=0
After=dbus.service systemd-logind.service systemd-user-sessions.service
Before=tilecast-edge.service tilecast-renderer.service display-manager.service

[Service]
Type=oneshot
ExecStart=/opt/tilecast-edge/current/bin/tilecast-edge-migrate recover
Restart=on-failure
RestartSec=15s
TimeoutStartSec=5min
StateDirectory=tilecast-edge-migrate
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
# systemd creates the runtime directory before it sets up the namespace:
# after a reboot /run is empty.
RuntimeDirectory=tilecast-edge-migrate
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=-/var/lib/tilecast-edge-migrate -/var/lib/tilecast-edge
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
