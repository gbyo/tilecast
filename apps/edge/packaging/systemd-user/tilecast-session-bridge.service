# Tilecast Edge session bridge (docs/tilecast-edge.md §4.4). A user unit in
# the tilecast account's session, because PipeWire is a per-user service.
# It connects to tilecastd's socket with the session_bridge role, reports
# which audio sources and sinks exist, and opens the microphone only while
# tilecastd asks for Noise Meter levels. It sends tilecastd RMS values only;
# no audio sample leaves the process.
#
# tilecast-session-bridge.path starts it while tilecastd's socket exists.
# The bridge exits when the socket is gone for good (Edge was stopped), and
# the path unit starts it again when the socket returns.
[Unit]
Description=Tilecast Edge session bridge
Documentation=https://github.com/gbyo/tilecast/blob/main/docs/tilecast-edge.md
ConditionUser=tilecast
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
# The bridge reconnects on its own across daemon restarts; systemd restarts
# it only after a crash.
ExecStart=/opt/tilecast-edge/current/bin/tilecast-session-bridge --socket=/run/tilecast-edge/edge.sock
Restart=on-failure
RestartSec=5
# A session that cannot run the bridge (no PipeWire, a broken sandbox) is
# retried with a growing delay, not every five seconds forever.
RestartSteps=6
RestartMaxDelaySec=300
UMask=0077
# The account's home can be /var/lib/tilecast-edge, which is hidden below.
WorkingDirectory=/
# No JIT: GStreamer's ORC code generator needs writable executable memory,
# which MemoryDenyWriteExecute= forbids. The plain C paths are enough for
# one 60 ms level measurement.
Environment=ORC_CODE=backup
Environment=GST_REGISTRY=/tmp/gstreamer-registry.bin

# Sandbox. The bridge talks to PipeWire and tilecastd over Unix sockets only,
# reads no files of the daemon and writes nothing.
RestrictAddressFamilies=AF_UNIX
# A user manager has no capabilities (no CAP_SETPCAP, no CAP_SYS_ADMIN).
# Nothing here may shrink the capability bounding set, or every start fails
# with 218/CAPABILITIES: that rules out CapabilityBoundingSet= and the
# options that set it implicitly (PrivateDevices=, ProtectKernelModules=,
# ProtectKernelLogs=, ProtectClock=). The bridge has no capabilities and
# NoNewPrivileges= keeps it so.
#
# Two layers:
# - seccomp (RestrictAddressFamilies=, SystemCallFilter=,
#   MemoryDenyWriteExecute=, RestrictNamespaces= and the rest) applies on
#   every host;
# - the mount options (ProtectSystem=, ProtectHome=, PrivateTmp=,
#   InaccessiblePaths=) need the unit's own user namespace (PrivateUsers=).
#   systemd skips them where unprivileged user namespaces are restricted
#   (Ubuntu 24.04's AppArmor default), and the bridge still starts.
PrivateUsers=yes
NoNewPrivileges=yes
ProtectSystem=strict
# Home directories are hidden; the session's runtime directory (PipeWire and
# the session bus) is the one part of /run/user that stays visible.
ProtectHome=tmpfs
BindReadOnlyPaths=%t
PrivateTmp=yes
# Audio goes through the PipeWire socket only; the account's display, input
# and sound device nodes stay hidden.
InaccessiblePaths=-/var/lib/tilecast-edge -/run/tilecast -/dev/snd -/dev/dri -/dev/input -/dev/bus/usb
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
