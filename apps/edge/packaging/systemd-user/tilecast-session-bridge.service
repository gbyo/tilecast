# Tilecast Edge session bridge (docs/tilecast-edge.md §4.4). A user unit in
# the tilecast account's session, because PipeWire is a per-user service.
# It connects to tilecastd's socket with the session_bridge role, reports
# which audio sources and sinks exist, and opens the microphone only while
# tilecastd asks for Noise Meter levels. It sends tilecastd RMS values only;
# no audio sample leaves the process.
#
# tilecast-session-bridge.path starts it while tilecastd's socket exists.
# The bridge exits when the socket is gone for good (Edge was stopped), and
# the path unit starts it again when the socket returns.
[Unit]
Description=Tilecast Edge session bridge
Documentation=https://github.com/gbyo/tilecast/blob/main/docs/tilecast-edge.md
ConditionUser=tilecast
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
# The bridge reconnects on its own across daemon restarts; systemd restarts
# it only after a crash.
ExecStart=/opt/tilecast-edge/current/bin/tilecast-session-bridge --socket=/run/tilecast-edge/edge.sock
Restart=on-failure
RestartSec=5
UMask=0077
# The account's home can be /var/lib/tilecast-edge, which is hidden below.
WorkingDirectory=/
# No JIT: GStreamer's ORC code generator needs writable executable memory,
# which MemoryDenyWriteExecute= forbids. The plain C paths are enough for
# one 60 ms level measurement.
Environment=ORC_CODE=backup
Environment=GST_REGISTRY=/tmp/gstreamer-registry.bin

# Sandbox. The bridge talks to PipeWire and tilecastd over Unix sockets only,
# reads no files of the daemon and writes nothing.
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# Home directories are hidden; the session's runtime directory (PipeWire and
# the session bus) is the one part of /run/user that stays visible.
ProtectHome=tmpfs
BindReadOnlyPaths=%t
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/var/lib/tilecast-edge -/run/tilecast
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
