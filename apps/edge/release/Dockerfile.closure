# A clean Debian 13 image for the release's runtime closure check.
#
# It has exactly the operating system baseline (system-baseline.txt) and
# nothing else: no -dev package, no WPE WebKit, no libwpe, and no Python,
# whose own dependencies would hide a library the baseline does not provide.
# verify-runtime-closure.sh runs here against the finished release tree,
# mounted where it installs. The base image and package snapshot are the
# release builder's (Dockerfile.builder), so the check sees the library
# versions the release was linked against.
#
#   docker build -t tilecast-edge-closure -f apps/edge/release/Dockerfile.closure apps/edge/release
FROM debian:trixie@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c
ARG SNAPSHOT=20260920T000000Z
ENV DEBIAN_FRONTEND=noninteractive
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${SNAPSHOT} trixie main" \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${SNAPSHOT} trixie-updates main" \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${SNAPSHOT} trixie-security main" \
      > /etc/apt/sources.list
COPY system-baseline.txt /tmp/system-baseline.txt
RUN apt-get update \
    && grep -v '^[[:space:]]*#' /tmp/system-baseline.txt | grep -v '^[[:space:]]*$' \
      | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/system-baseline.txt
COPY verify-runtime-closure.sh /usr/local/bin/verify-runtime-closure.sh
ENTRYPOINT ["/usr/local/bin/verify-runtime-closure.sh"]
