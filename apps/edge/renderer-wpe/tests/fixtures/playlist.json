        "durationMs": null,
        "fitMode": "contain",
        "audioEnabled": false,
        "volume": 1.0,
        "videoStartOffsetMs": null,
        "videoEndOffsetMs": null
      },
      {
        "id": "item-widget",
        "kind": "widget",
        "src": "",
        "durationMs": 3000,
        "fitMode": "contain",
        "audioEnabled": false,
        "volume": 1.0,
        "videoStartOffsetMs": null,
        "videoEndOffsetMs": null,
        "widget": {
          "background": "#123456",
          "root": {
