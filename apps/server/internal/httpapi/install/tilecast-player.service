# Tilecast Player systemd unit (user session).
#
# This is the outermost rung of the self-heal ladder: if the player process
# exits for any reason — a crash, an out-of-memory kill, or its own
# restart_player_process command — systemd starts it again, forever.
# Install as a user unit on the kiosk account:
#
#   mkdir -p ~/.config/systemd/user
#   cp tilecast-player.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable tilecast-player   # --now would start a second copy
#                                             # if a player is already running
#   sudo loginctl enable-linger <kiosk-user>   # start at boot without login
#
# Set the server address once via the on-screen setup, or here:
#   systemctl --user edit tilecast-player
#   [Service]
#   Environment=TILECAST_SERVER_URL=https://signage.example.org

[Unit]
Description=Tilecast Player
After=graphical-session.target network.target
PartOf=graphical-session.target
# Never give up: with the rate-limit window disabled, a crash loop keeps
# backing off on RestartSec rather than latching into "failed". This directive
# belongs in [Unit] on modern systemd (it is ignored under [Service]).
StartLimitIntervalSec=0

[Service]
Type=simple
# Remove stale FUSE mounts left by a legacy AppImage launch before retrying.
# The command only targets AppImage temporary FUSE mountpoints and is
# best-effort; current releases use extract-and-run and do not mount FUSE.
ExecStartPre=/bin/sh -c 'command -v findmnt >/dev/null 2>&1 || exit 0; findmnt -rn -o TARGET,FSTYPE | while read -r mountpoint fstype; do case "$mountpoint:$fstype" in /tmp/.mount_*:fuse*) fusermount3 -uz "$mountpoint" 2>/dev/null || fusermount -uz "$mountpoint" 2>/dev/null || umount -l "$mountpoint" 2>/dev/null || true; rmdir "$mountpoint" 2>/dev/null || true;; esac; done'
# Extract-and-run is an AppImage runtime mode, not an unpacked installation.
# It avoids a host FUSE 2 dependency while preserving APPIMAGE as the path to
# this file, so signed Studio updates can still replace it atomically.
ExecStart=%h/tilecast/tilecast-player.AppImage --appimage-extract-and-run
Restart=always
RestartSec=5
# UxPlay is provisioned into /usr/local/bin. Keep the managed player's host
# tools discoverable even when the display manager supplied a minimal PATH.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=TILECAST_LOG_LEVEL=info
# Electron's Node HTTP client uses bundled roots unless given the host CA
# bundle. This keeps private-CA HTTPS verification aligned with curl/system
# trust on Debian-family hosts; it does not accept an untrusted certificate.
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
# Wayland kiosks (cage/weston): uncomment as needed
# Environment=WAYLAND_DISPLAY=wayland-0
# X11 kiosks:
# Environment=DISPLAY=:0

[Install]
WantedBy=graphical-session.target
