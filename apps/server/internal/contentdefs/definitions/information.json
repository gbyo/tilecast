{
  "widgets": [
    {
      "id": "fundraising-thermometer",
      "version": 1,
      "apiVersion": 1,
      "name": "Fundraising Thermometer",
      "description": "Show progress toward a fundraising or campaign goal.",
      "category": "Information",
      "icon": "target",
      "thumbnail": "fundraising-thermometer",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "dataSourceId",
            "label": "Data Source",
            "control": "data_source",
            "required": true,
            "acceptedDataSourceKinds": [
              "object"
            ],
            "requiredFields": {
              "current": "number",
              "target": "number"
            }
          },
          {
            "key": "currentField",
            "label": "Raised-so-far field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": [
              "number",
              "integer",
              "currency"
            ],
            "default": "current"
          },
          {
            "key": "targetField",
            "label": "Goal field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": [
              "number",
              "integer",
              "currency"
            ],
            "default": "target"
          },
          {
            "key": "heading",
            "label": "Heading",
            "control": "text",
            "required": true,
            "minLength": 1,
            "maxLength": 120,
            "default": "Our goal"
          },
          {
            "key": "valueFormat",
            "label": "Value format",
            "control": "select",
            "required": true,
            "default": "currency",
            "options": [
              {
                "value": "currency",
                "label": "Currency"
              },
              {
                "value": "number",
                "label": "Number"
              },
              {
                "value": "integer",
                "label": "Whole number"
              }
            ]
          },
          {
            "key": "showPercent",
            "label": "Show percentage",
            "control": "boolean",
            "default": true
          },
          {
            "key": "completionText",
            "label": "Completion text",
            "control": "text",
            "required": true,
            "maxLength": 120,
            "default": "Goal reached. Thank you!"
          },
          {
            "key": "foregroundColor",
            "label": "Text color",
            "control": "color",
            "required": true,
            "default": "#ffffff"
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "required": true,
            "default": "#123b2c"
          }
        ]
      },
      "defaultConfiguration": {
        "dataSourceId": "",
        "currentField": "current",
        "targetField": "target",
        "heading": "Our goal",
        "valueFormat": "currency",
        "showPercent": true,
        "completionText": "Goal reached. Thank you!",
        "foregroundColor": "#ffffff",
        "backgroundColor": "#123b2c"
      },
      "acceptedDataSourceKinds": [
        "object"
      ],
      "requiredFieldTypes": {
        "current": "number",
        "target": "number"
      },
      "presentationSchemaVersion": 1,
      "presentationTemplate": {
        "type": "surface",
        "props": {
          "backgroundColor": {
            "$config": "backgroundColor"
          },
          "padding": 16
        },
        "children": [
          {
            "type": "column",
            "props": {
              "align": "center",
              "gap": 14
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "role": "title",
                  "align": "center",
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "literal",
                  "value": {
                    "$config": "heading"
                  }
                }
              },
              {
                "type": "text",
                "props": {
                  "role": "metric",
                  "align": "center",
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "dataset",
                  "dataset": {
                    "$config": "dataSourceId",
                    "suffix": ":object"
                  },
                  "path": {
                    "$config": "currentField"
                  },
                  "format": {
                    "$config": "valueFormat"
                  },
                  "fallback": "0"
                }
              },
              {
                "type": "progress",
                "props": {
                  "targetIsField": true,
                  "target": {
                    "$config": "targetField"
                  },
                  "showPercent": {
                    "$config": "showPercent"
                  },
                  "completionText": {
                    "$config": "completionText"
                  },
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "dataset",
                  "dataset": {
                    "$config": "dataSourceId",
                    "suffix": ":object"
                  },
                  "path": {
                    "$config": "currentField"
                  },
                  "fallback": "0"
                }
              }
            ]
          }
        ]
      },
      "requiredCapabilities": {
        "layout.surface": 1,
        "layout.column": 1,
        "content.text": 1,
        "content.progress": 2,
        "binding.core": 2,
        "format.typed": 1
      },
      "emptyStateBehavior": "configured_text",
      "requiresManifestV13": true,
      "setup": {
        "eyebrow": "Needs a goal Data Source",
        "tip": "Update the raised-so-far number in the Data Source; every screen using this Widget follows within one refresh.",
        "steps": [
          "Create a Fundraising Goal Data Source with your target.",
          "Select it here and confirm the two numeric fields.",
          "Update the raised amount as the campaign progresses."
        ]
      },
      "deprecation": {
        "deprecated": true,
        "replacement": "progress",
        "message": "Create Progress with the thermometer style instead. Saved Fundraising Thermometer content keeps working."
      },
      "component": {
        "type": "tilecast.progress",
        "version": 1,
        "tagName": "tc-widget-progress",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "dataSourceId": {
            "$config": "dataSourceId",
            "default": ""
          },
          "valueField": {
            "$config": "currentField",
            "default": "current"
          },
          "targetField": {
            "$config": "targetField",
            "default": "target"
          },
          "label": {
            "$config": "heading",
            "default": ""
          },
          "labelField": {
            "$config": "labelField",
            "default": ""
          },
          "format": {
            "$config": "valueFormat",
            "default": "currency"
          },
          "precision": {
            "$config": "precision",
            "default": 1
          },
          "showPercent": {
            "$config": "showPercent",
            "default": true
          },
          "completionText": {
            "$config": "completionText",
            "default": ""
          },
          "style": "thermometer",
          "emptyText": {
            "$config": "emptyText",
            "default": ""
          },
          "background": {
            "$config": "backgroundColor",
            "default": ""
          },
          "foreground": {
            "$config": "foregroundColor",
            "default": ""
          }
        },
        "dataSourceFields": [
          "dataSourceId"
        ],
        "empty": "skip-eligible"
      },
      "compatibility": {
        "fallback": "template"
      }
    },
    {
      "id": "now-and-next",
      "version": 1,
      "apiVersion": 1,
      "name": "Now and Next",
      "description": "Feature the current record and list the ones that follow it.",
      "category": "Schedules",
      "icon": "schedule",
      "thumbnail": "now-and-next",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "dataSourceId",
            "label": "Data Source",
            "control": "data_source",
            "required": true,
            "acceptedDataSourceKinds": [
              "records"
            ]
          },
          {
            "key": "titleField",
            "label": "Title field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": [
              "text"
            ],
            "default": "title"
          },
          {
            "key": "detailField",
            "label": "Detail field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": [
              "text",
              "date",
              "datetime"
            ],
            "default": "start"
          },
          {
            "key": "nowLabel",
            "label": "Current label",
            "control": "text",
            "required": true,
            "minLength": 1,
            "maxLength": 40,
            "default": "Now"
          },
          {
            "key": "nextLabel",
            "label": "Upcoming label",
            "control": "text",
            "required": true,
            "minLength": 1,
            "maxLength": 40,
            "default": "Next"
          },
          {
            "key": "upcomingCount",
            "label": "Upcoming rows",
            "control": "integer",
            "required": true,
            "default": 3,
            "minimum": 1,
            "maximum": 8
          },
          {
            "key": "foregroundColor",
            "label": "Text color",
            "control": "color",
            "required": true,
            "default": "#ffffff"
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "required": true,
            "default": "#101f33"
          },
          {
            "key": "emptyState",
            "label": "Empty-state text",
            "control": "multiline_text",
            "required": true,
            "maxLength": 300,
            "default": "Nothing scheduled"
          },
          {
            "key": "autoSkipWhenEmpty",
            "label": "Skip when nothing is scheduled",
            "description": "When this Widget is a playlist item, advance immediately if the selected record set is empty.",
            "control": "boolean",
            "default": false
          }
        ]
      },
      "defaultConfiguration": {
        "dataSourceId": "",
        "titleField": "title",
        "detailField": "start",
        "nowLabel": "Now",
        "nextLabel": "Next",
        "upcomingCount": 3,
        "foregroundColor": "#ffffff",
        "backgroundColor": "#101f33",
        "emptyState": "Nothing scheduled",
        "autoSkipWhenEmpty": false
      },
      "acceptedDataSourceKinds": [
        "records"
      ],
      "presentationSchemaVersion": 1,
      "presentationTemplate": {
        "type": "surface",
        "props": {
          "backgroundColor": {
            "$config": "backgroundColor"
          },
          "padding": 16,
          "autoSkipWhenEmpty": {
            "$config": "autoSkipWhenEmpty"
          },
          "emptyCondition": {
            "binding": {
              "source": "dataset",
              "dataset": {
                "$config": "dataSourceId",
                "suffix": ":records"
              },
              "path": {
                "$config": "titleField"
              }
            },
            "op": "empty"
          }
        },
        "children": [
          {
            "type": "column",
            "props": {
              "gap": 10
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "role": "label",
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "literal",
                  "value": {
                    "$config": "nowLabel"
                  }
                }
              },
              {
                "type": "text",
                "props": {
                  "role": "metric",
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "dataset",
                  "dataset": {
                    "$config": "dataSourceId",
                    "suffix": ":records"
                  },
                  "path": {
                    "$config": "titleField"
                  },
                  "fallback": {
                    "$config": "emptyState"
                  }
                }
              },
              {
                "type": "text",
                "props": {
                  "role": "body",
                  "maxLines": 1,
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "dataset",
                  "dataset": {
                    "$config": "dataSourceId",
                    "suffix": ":records"
                  },
                  "path": {
                    "$config": "detailField"
                  },
                  "fallback": ""
                }
              },
              {
                "type": "divider"
              },
              {
                "type": "text",
                "props": {
                  "role": "label",
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "literal",
                  "value": {
                    "$config": "nextLabel"
                  }
                }
              },
              {
                "type": "repeat",
                "props": {
                  "emptyState": {
                    "$config": "emptyState"
                  }
                },
                "repeat": {
                  "dataset": {
                    "$config": "dataSourceId",
                    "suffix": ":records"
                  },
                  "limit": {
                    "$config": "upcomingCount"
                  },
                  "offset": 1
                },
                "children": [
                  {
                    "type": "row",
                    "props": {
                      "gap": 12
                    },
                    "children": [
                      {
                        "type": "text",
                        "props": {
                          "role": "body",
                          "maxLines": 1,
                          "color": {
                            "$config": "foregroundColor"
                          }
                        },
                        "binding": {
                          "source": "repeat",
                          "path": {
                            "$config": "detailField"
                          }
                        }
                      },
                      {
                        "type": "text",
                        "props": {
                          "role": "body",
                          "maxLines": 1,
                          "color": {
                            "$config": "foregroundColor"
                          }
                        },
                        "binding": {
                          "source": "repeat",
                          "path": {
                            "$config": "titleField"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "requiredCapabilities": {
        "layout.surface": 1,
        "layout.column": 1,
        "layout.row": 1,
        "layout.divider": 1,
        "content.text": 1,
        "collection.repeat": 2,
        "binding.core": 2
      },
      "emptyStateBehavior": "configured_text",
      "requiresManifestV13": true,
      "setup": {
        "eyebrow": "Needs a record Data Source",
        "tip": "Set the Data Source date selection to Next available so the current record is genuinely the current one.",
        "steps": [
          "Choose a Calendar, Events, or other record Data Source.",
          "Pick the title and detail fields to show.",
          "Choose how many upcoming rows fit your screen."
        ]
      },
      "legacyEditor": false,
      "component": {
        "type": "tilecast.agenda",
        "version": 1,
        "tagName": "tc-widget-agenda",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "dataSourceId": {
            "$config": "dataSourceId",
            "default": ""
          },
          "titleField": {
            "$config": "titleField",
            "default": "title"
          },
          "startField": "",
          "endField": "",
          "locationField": "",
          "descriptionField": {
            "$config": "detailField",
            "default": ""
          },
          "categoryField": "",
          "heading": "",
          "maximumItems": 100,
          "groupByDay": false,
          "hideEnded": true,
          "emptyText": {
            "$config": "emptyState",
            "default": "Nothing scheduled"
          },
          "style": "now-next",
          "nowLabel": {
            "$config": "nowLabel",
            "default": "Now"
          },
          "nextLabel": {
            "$config": "nextLabel",
            "default": "Next"
          },
          "upcomingCount": {
            "$config": "upcomingCount",
            "default": 3
          },
          "showCountdown": false,
          "showUpcomingTimeline": true,
          "background": {
            "$config": "backgroundColor",
            "default": "#101f33"
          },
          "foreground": {
            "$config": "foregroundColor",
            "default": "#ffffff"
          },
          "accent": ""
        },
        "dataSourceFields": [
          "dataSourceId"
        ],
        "empty": "skip-eligible"
      },
      "compatibility": {
        "fallback": "template"
      },
      "deprecation": {
        "deprecated": true,
        "replacement": "agenda",
        "message": "Use Agenda with the Now and next style for new Widgets."
      }
    },
    {
      "id": "recognition-board",
      "version": 1,
      "apiVersion": 1,
      "name": "Recognition Board",
      "description": "Display names and short notes in a card grid.",
      "category": "Information",
      "icon": "award",
      "thumbnail": "recognition-board",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "dataSourceId",
            "label": "Data Source",
            "control": "data_source",
            "required": true,
            "acceptedDataSourceKinds": [
              "records"
            ]
          },
          {
            "key": "nameField",
            "label": "Name field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": [
              "text"
            ],
            "default": "title"
          },
          {
            "key": "noteField",
            "label": "Note field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": [
              "text"
            ],
            "default": "description"
          },
          {
            "key": "heading",
            "label": "Heading",
            "control": "text",
            "required": true,
            "minLength": 1,
            "maxLength": 120,
            "default": "Recognition"
          },
          {
            "key": "columns",
            "label": "Columns",
            "control": "integer",
            "required": true,
            "default": 2,
            "minimum": 1,
            "maximum": 4
          },
          {
            "key": "maxItems",
            "label": "Maximum cards",
            "control": "integer",
            "required": true,
            "default": 8,
            "minimum": 1,
            "maximum": 24
          },
          {
            "key": "foregroundColor",
            "label": "Text color",
            "control": "color",
            "required": true,
            "default": "#ffffff"
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "required": true,
            "default": "#1b1733"
          },
          {
            "key": "emptyState",
            "label": "Empty-state text",
            "control": "multiline_text",
            "required": true,
            "maxLength": 300,
            "default": "No entries yet"
          },
          {
            "key": "autoSkipWhenEmpty",
            "label": "Skip when there are no entries",
            "description": "When this Widget is a playlist item, advance immediately if the selected record set is empty.",
            "control": "boolean",
            "default": false
          }
        ]
      },
      "defaultConfiguration": {
        "dataSourceId": "",
        "nameField": "title",
        "noteField": "description",
        "heading": "Recognition",
        "columns": 2,
        "maxItems": 8,
        "foregroundColor": "#ffffff",
        "backgroundColor": "#1b1733",
        "emptyState": "No entries yet",
        "autoSkipWhenEmpty": false
      },
      "acceptedDataSourceKinds": [
        "records"
      ],
      "presentationSchemaVersion": 1,
      "presentationTemplate": {
        "type": "surface",
        "props": {
          "backgroundColor": {
            "$config": "backgroundColor"
          },
          "padding": 16,
          "autoSkipWhenEmpty": {
            "$config": "autoSkipWhenEmpty"
          },
          "emptyCondition": {
            "binding": {
              "source": "dataset",
              "dataset": {
                "$config": "dataSourceId",
                "suffix": ":records"
              },
              "path": {
                "$config": "nameField"
              }
            },
            "op": "empty"
          }
        },
        "children": [
          {
            "type": "column",
            "props": {
              "gap": 12
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "role": "title",
                  "color": {
                    "$config": "foregroundColor"
                  }
                },
                "binding": {
                  "source": "literal",
                  "value": {
                    "$config": "heading"
                  }
                }
              },
              {
                "type": "grid",
                "props": {
                  "columns": {
                    "$config": "columns"
                  },
                  "gap": 12
                },
                "children": [
                  {
                    "type": "repeat",
                    "props": {
                      "emptyState": {
                        "$config": "emptyState"
                      }
                    },
                    "repeat": {
                      "dataset": {
                        "$config": "dataSourceId",
                        "suffix": ":records"
                      },
                      "limit": {
                        "$config": "maxItems"
                      }
                    },
                    "children": [
                      {
                        "type": "column",
                        "props": {
                          "fill": false,
                          "gap": 4
                        },
                        "children": [
                          {
                            "type": "text",
                            "props": {
                              "role": "title",
                              "maxLines": 1,
                              "color": {
                                "$config": "foregroundColor"
                              }
                            },
                            "binding": {
                              "source": "repeat",
                              "path": {
                                "$config": "nameField"
                              }
                            }
                          },
                          {
                            "type": "text",
                            "props": {
                              "role": "body",
                              "maxLines": 3,
                              "color": {
                                "$config": "foregroundColor"
                              }
                            },
                            "binding": {
                              "source": "repeat",
                              "path": {
                                "$config": "noteField"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "requiredCapabilities": {
        "layout.surface": 1,
        "layout.column": 1,
        "layout.grid": 1,
        "content.text": 1,
        "collection.repeat": 2,
        "binding.core": 2
      },
      "emptyStateBehavior": "configured_text",
      "requiresManifestV13": true,
      "setup": {
        "eyebrow": "Needs a record Data Source",
        "tip": "Two columns stay readable from across a room; four suits a large display viewed up close.",
        "steps": [
          "Choose a Shout-outs, Manual Table, or other record Data Source.",
          "Map the name and note fields.",
          "Pick a column count that matches your screen size."
        ]
      },
      "legacyEditor": false,
      "component": {
        "type": "tilecast.cards",
        "version": 1,
        "tagName": "tc-widget-cards",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "dataSourceId": {
            "$config": "dataSourceId",
            "default": ""
          },
          "titleField": {
            "$config": "nameField",
            "default": "title"
          },
          "subtitleField": "",
          "bodyField": {
            "$config": "noteField",
            "default": "description"
          },
          "imageField": "",
          "badgeField": "",
          "metadataField": "",
          "heading": {
            "$config": "heading",
            "default": "Recognition"
          },
          "maximumItems": {
            "$config": "maxItems",
            "default": 8
          },
          "emptyText": {
            "$config": "emptyState",
            "default": "No entries yet"
          },
          "density": "comfortable",
          "background": {
            "$config": "backgroundColor",
            "default": "#1b1733"
          },
          "foreground": {
            "$config": "foregroundColor",
            "default": "#ffffff"
          }
        },
        "dataSourceFields": [
          "dataSourceId"
        ],
        "empty": "skip-eligible"
      },
      "compatibility": {
        "fallback": "template"
      },
      "deprecation": {
        "deprecated": true,
        "replacement": "cards",
        "message": "Use Cards for new record card displays."
      }
    }
  ],
  "dataSources": [
    {
      "id": "emergency-message",
      "version": 1,
      "name": "Emergency Message",
      "description": "Maintain one current alert message, severity, and instructions.",
      "category": "Information",
      "icon": "alert",
      "configurationSchema": {
        "fields": [
          {
            "key": "message",
            "label": "Message",
            "control": "multiline_text",
            "required": true,
            "minLength": 1,
            "maxLength": 1000,
            "default": "No active alerts."
          },
          {
            "key": "severity",
            "label": "Severity",
            "control": "select",
            "required": true,
            "default": "normal",
            "options": [
              {
                "value": "normal",
                "label": "Normal"
