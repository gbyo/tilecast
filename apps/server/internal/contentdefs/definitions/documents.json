{
  "widgets": [
    {
      "id": "canva",
      "version": 2,
      "name": "Canva",
      "description": "Display a published Canva design or presentation.",
      "category": "Design & Documents",
      "icon": "canva",
      "thumbnail": "canva",
      "kind": "app",
      "featured": true,
      "keywords": ["design", "presentation", "document"],
      "runtime": "web",
      "configurationSchema": {
        "fields": [
          {
            "key": "canvaUrl",
            "label": "Canva design link",
            "labelKey": "definitions:canva.fields.canvaUrl.label",
            "description": "Paste a public design view link, Smart embed link, iframe src URL, or canva.link short link. Publish a public embed in Canva first.",
            "descriptionKey": "definitions:canva.fields.canvaUrl.description",
            "control": "url",
            "required": true
          },
          {
            "key": "slideshow",
            "label": "Slideshow",
            "labelKey": "definitions:canva.fields.slideshow.label",
            "description": "Open the design in Canva's presentation/watch mode. Canva may still require playback to be started.",
            "descriptionKey": "definitions:canva.fields.slideshow.description",
            "control": "boolean"
          },
          {
            "key": "refreshIntervalSeconds",
            "label": "Reload interval",
            "labelKey": "definitions:canva.fields.refreshIntervalSeconds.label",
            "control": "integer",
            "required": true,
            "minimum": 60,
            "maximum": 86400,
            "default": 1800
          }
        ]
      },
      "defaultConfiguration": {
        "canvaUrl": "",
        "slideshow": false,
        "refreshIntervalSeconds": 1800
      },
      "presentationSchemaVersion": 1,
      "requiredCapabilities": { "web.remote": 2 },
      "emptyStateBehavior": "placeholder",
      "webIntegration": {
        "urlField": "canvaUrl",
        "allowedHosts": ["www.canva.com"],
        "transform": "canva_embed",
        "reloadIntervalField": "refreshIntervalSeconds",
        "loadTimeoutSeconds": 30,
        "lifecycle": "keep_warm",
        "warmSeconds": 60,
        "fallbackBehavior": "placeholder"
      },
      "setup": {
        "eyebrow": "Canva",
        "steps": [
          "In Canva, select Share > See all > Embed and publish a public embed.",
          "Paste the Smart embed link or the src URL from the HTML iframe. Public view and design short links are also accepted."
        ],
        "tip": "A public view link alone does not enable embedding. Private designs and login are not supported. Presentation mode uses Canva's watch surface; Tilecast does not force Canva autoplay."
      },
      "deprecation": {}
    },
    {
      "id": "notion",
      "version": 1,
      "name": "Notion",
      "description": "Display a published Notion page.",
      "category": "Design & Documents",
      "icon": "notion",
      "kind": "app",
      "availability": {
        "enabled": false,
        "reason": "Notion's public pages do not provide a dependable first-party signage embed contract."
      },
      "runtime": "web",
      "configurationSchema": { "fields": [] },
      "defaultConfiguration": {},
      "presentationSchemaVersion": 1,
      "requiredCapabilities": { "web.remote": 1 },
      "emptyStateBehavior": "placeholder",
      "legacyEditor": true,
      "deprecation": {}
    }
  ],
  "dataSources": []
}
