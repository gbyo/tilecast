      "icon": "calendar",
      "configurationSchema": {
        "fields": [
          {
            "key": "records",
            "label": "Events",
            "control": "repeating_group",
            "maximumItems": 60,
            "itemFields": [
              {
                "key": "title",
                "label": "Event",
                "control": "text",
                "required": true,
                "minLength": 1,
                "maxLength": 160,
                "default": "Event"
              },
              {
                "key": "start",
                "label": "Starts",
                "control": "datetime"
              },
              {
                "key": "location",
                "label": "Location",
                "control": "text",
                "default": "",
                "maxLength": 120
              },
              {
                "key": "description",
                "label": "Details",
                "control": "multiline_text",
                "default": "",
                "maxLength": 600
              },
              {
                "key": "expiresAt",
                "label": "Remove after",
                "control": "datetime"
              }
            ]
          }
        ]
      },
      "defaultConfiguration": { "records": [] },
      "outputSchema": {
        "kind": "records",
        "fields": [
          {
            "key": "title",
            "label": "Event",
            "type": "text",
            "required": true
          },
          { "key": "start", "label": "Starts", "type": "datetime" },
          { "key": "location", "label": "Location", "type": "text" },
          { "key": "description", "label": "Details", "type": "text" },
          { "key": "expiresAt", "label": "Remove after", "type": "datetime" }
        ]
      },
      "adapterId": "manual_records",
      "refreshBehavior": "manual",
      "requiresManifestV13": true,
      "setup": {
        "eyebrow": "Maintained in Studio",
        "tip": "Events sort by start time, so a Now and Next Widget features the next one automatically.",
        "steps": [
          "Add a row for each event with its start time.",
          "Set Remove after so it clears itself once it is over.",
          "Select it from an Agenda, Now and Next, or Cards Widget."
        ]
      },
      "deprecation": {}
    },
    {
      "id": "closures",
      "version": 1,
      "name": "Closures and Delays",
      "description": "Publish closures, delays, and cancellations for a set window.",
      "category": "Structured",
      "icon": "alert",
      "configurationSchema": {
        "fields": [
          {
            "key": "records",
            "label": "Closures",
            "control": "repeating_group",
            "maximumItems": 60,
            "itemFields": [
              {
                "key": "title",
                "label": "What is affected",
                "control": "text",
                "required": true,
                "minLength": 1,
                "maxLength": 160,
                "default": "Closure"
              },
              {
                "key": "status",
                "label": "Status",
                "control": "select",
                "required": true,
                "default": "closed",
                "options": [
                  { "value": "closed", "label": "Closed" },
                  { "value": "delayed", "label": "Delayed" },
                  { "value": "cancelled", "label": "Cancelled" },
                  { "value": "relocated", "label": "Relocated" }
                ]
              },
              {
                "key": "body",
                "label": "Details",
                "control": "multiline_text",
                "default": "",
                "maxLength": 600
              },
              {
                "key": "priority",
                "label": "Priority",
                "control": "integer",
                "required": true,
                "default": 0,
                "minimum": 0,
                "maximum": 100
              },
              {
                "key": "publishAt",
                "label": "Publish at",
                "control": "datetime"
              },
              {
                "key": "expiresAt",
                "label": "Expires at",
                "control": "datetime"
              }
            ]
          }
        ]
      },
      "defaultConfiguration": { "records": [] },
      "outputSchema": {
        "kind": "records",
        "fields": [
          {
            "key": "title",
            "label": "What is affected",
            "type": "text",
            "required": true
          },
          {
            "key": "status",
            "label": "Status",
            "type": "text",
            "required": true
          },
          { "key": "body", "label": "Details", "type": "text" },
          { "key": "priority", "label": "Priority", "type": "integer" },
          { "key": "publishAt", "label": "Publish at", "type": "datetime" },
          { "key": "expiresAt", "label": "Expires at", "type": "datetime" }
        ]
      },
      "adapterId": "manual_records",
      "refreshBehavior": "manual",
      "requiresManifestV13": true,
      "setup": {
        "eyebrow": "Maintained in Studio",
        "tip": "Enter tomorrow's closures the night before with a publish time. They appear on their own in the morning.",
        "steps": [
          "Add a row for each closure, delay, or cancellation.",
          "Set the window it should be visible for.",
          "Select it from a List, Table, or Ticker Widget."
        ]
      },
      "deprecation": {}
    },
