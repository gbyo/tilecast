    {
      "id": "menu-items",
      "version": 2,
      "name": "Menu Items",
      "description": "Maintain menu or price-board rows with optional daily windows.",
      "category": "Structured",
      "icon": "menu",
      "configurationSchema": {
        "fields": [
          {
            "key": "priceCurrency",
            "label": "Price currency",
            "description": "ISO 4217 code for every price, such as EUR, GBP, or JPY.",
            "control": "currency_code",
            "maxLength": 3,
            "default": ""
          },
          {
            "key": "records",
            "label": "Items",
            "control": "repeating_group",
            "maximumItems": 100,
            "itemFields": [
              {
                "key": "title",
                "label": "Item",
                "control": "text",
                "required": true,
                "minLength": 1,
                "maxLength": 160,
                "default": "Item"
              },
              {
                "key": "detail",
                "label": "Description",
                "control": "text",
                "default": "",
                "maxLength": 240
              },
              {
                "key": "price",
                "label": "Price",
                "control": "number",
                "required": true,
                "default": 0,
                "minimum": 0,
                "maximum": 100000
              },
              {
                "key": "category",
                "label": "Section",
                "control": "text",
                "default": "",
                "maxLength": 60
              },
              {
                "key": "priority",
                "label": "Sort priority",
                "control": "integer",
                "required": true,
                "default": 0,
                "minimum": 0,
                "maximum": 100
              },
              {
                "key": "publishAt",
                "label": "Available from",
                "control": "datetime"
              },
              {
                "key": "expiresAt",
                "label": "Available until",
                "control": "datetime"
              }
            ]
          }
        ]
      },
      "defaultConfiguration": { "priceCurrency": "", "records": [] },
      "outputSchema": {
        "kind": "records",
        "fields": [
          {
            "key": "title",
            "label": "Item",
            "type": "text",
            "required": true
          },
          { "key": "detail", "label": "Description", "type": "text" },
          {
            "key": "price",
            "label": "Price",
            "type": "currency",
            "currencyConfigKey": "priceCurrency",
            "required": true
          },
          { "key": "category", "label": "Section", "type": "text" },
          { "key": "priority", "label": "Sort priority", "type": "integer" },
          { "key": "publishAt", "label": "Available from", "type": "datetime" },
          {
            "key": "expiresAt",
            "label": "Available until",
            "type": "datetime"
          }
        ]
      },
      "adapterId": "manual_records",
      "refreshBehavior": "manual",
      "requiresManifestV13": true,
      "setup": {
        "eyebrow": "Maintained in Studio",
        "tip": "Price is typed as currency, so a Menu or Table Widget formats it without extra configuration.",
        "steps": [
          "Add a row for each item and its price.",
          "Use the availability window for specials that should come and go on their own.",
          "Select it from a Menu, Table, or Cards Widget."
        ]
      },
      "deprecation": {}
    },
