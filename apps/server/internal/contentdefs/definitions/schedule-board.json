{
  "widgets": [
    {
      "id": "schedule-board",
      "version": 1,
      "apiVersion": 1,
      "name": "School Schedule",
      "description": "Show the current event, a live countdown, and upcoming event cards.",
      "category": "Schedules",
      "icon": "schedule",
      "thumbnail": "schedule-board",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "dataSourceId",
            "label": "Schedule Data Source",
            "description": "Choose a Calendar or another record source with start and end times.",
            "control": "data_source",
            "required": true,
            "acceptedDataSourceKinds": ["records"]
          },
          {
            "key": "titleField",
            "label": "Event name",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": ["text"],
            "default": "title"
          },
          {
            "key": "startField",
            "label": "Start time",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": ["datetime"],
            "default": "startTime"
          },
          {
            "key": "endField",
            "label": "End time",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": ["datetime"],
            "default": "endTime"
          },
          {
            "key": "locationField",
            "label": "Location or detail",
            "control": "data_source_field",
            "required": false,
            "dataSourceFieldTypes": ["text"],
            "default": ""
          },
          {
            "key": "upcomingCount",
            "label": "Upcoming cards",
            "control": "integer",
            "required": true,
            "minimum": 1,
            "maximum": 8,
            "default": 4
          },
          {
            "key": "columns",
            "label": "Card columns",
            "control": "integer",
            "required": true,
            "minimum": 1,
            "maximum": 4,
            "default": 2
          },
          {
            "key": "showCountdown",
            "label": "Show live countdown",
            "description": "Show the time until the next event starts or the current event ends.",
            "control": "boolean",
            "default": true
          },
          {
            "key": "showUpcomingTimeline",
            "label": "Show upcoming timeline",
            "description": "Show upcoming events as a timeline of cards below the featured event.",
            "control": "boolean",
            "default": true
          },
          {
            "key": "featuredTextSize",
            "label": "Featured event size",
            "control": "integer",
            "required": true,
            "minimum": 28,
            "maximum": 120,
            "default": 58
          },
          {
            "key": "countdownTextSize",
            "label": "Countdown size",
            "control": "integer",
            "required": true,
            "minimum": 18,
            "maximum": 96,
            "default": 42
          },
          {
            "key": "cardTitleTextSize",
            "label": "Card title size",
            "control": "integer",
            "required": true,
            "minimum": 14,
            "maximum": 48,
            "default": 26
          },
          {
            "key": "cardDetailTextSize",
            "label": "Card detail size",
            "control": "integer",
            "required": true,
            "minimum": 12,
            "maximum": 36,
            "default": 18
          },
          {
            "key": "foregroundColor",
            "label": "Text color",
            "control": "color",
            "required": true,
            "default": "#ffffff"
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "required": true,
            "default": "#101f33"
          },
          {
            "key": "accentColor",
            "label": "Accent color",
            "control": "color",
            "required": true,
            "default": "#5dd6c0"
          },
          {
            "key": "cardBackgroundColor",
            "label": "Card background",
            "control": "color",
            "required": true,
            "default": "#19324d"
          },
          {
            "key": "emptyState",
            "label": "Empty-state text",
            "control": "multiline_text",
            "required": true,
            "maxLength": 240,
            "default": "No more events scheduled"
          },
          {
            "key": "autoSkipWhenEmpty",
            "label": "Skip when no events remain",
            "description": "When this Widget is a playlist item, advance immediately if there is no current or upcoming event.",
            "control": "boolean",
            "default": false
          }
        ]
      },
      "defaultConfiguration": {
        "dataSourceId": "",
        "titleField": "title",
        "startField": "startTime",
        "endField": "endTime",
        "locationField": "",
        "upcomingCount": 4,
        "columns": 2,
        "showCountdown": true,
        "showUpcomingTimeline": true,
        "featuredTextSize": 58,
        "countdownTextSize": 42,
        "cardTitleTextSize": 26,
        "cardDetailTextSize": 18,
        "foregroundColor": "#ffffff",
        "backgroundColor": "#101f33",
        "accentColor": "#5dd6c0",
        "cardBackgroundColor": "#19324d",
        "emptyState": "No more events scheduled",
        "autoSkipWhenEmpty": false
      },
      "acceptedDataSourceKinds": ["records"],
      "presentationSchemaVersion": 1,
      "presentationTemplate": {
        "type": "surface",
        "props": {
          "backgroundColor": { "$config": "backgroundColor" },
          "padding": 24,
          "autoSkipWhenEmpty": { "$config": "autoSkipWhenEmpty" },
          "emptyCondition": {
            "binding": {
              "source": "dataset",
              "dataset": {
                "$config": "dataSourceId",
                "suffix": ":records"
              },
              "path": { "$config": "titleField" },
              "selector": "current_or_next",
              "startField": { "$config": "startField" },
              "endField": { "$config": "endField" }
            },
            "op": "empty"
          }
        },
        "children": [
          {
            "type": "column",
            "props": { "gap": 18 },
            "children": [
              {
                "type": "conditional",
                "condition": {
                  "binding": {
                    "source": "dataset",
                    "dataset": {
                      "$config": "dataSourceId",
                      "suffix": ":records"
                    },
                    "path": { "$config": "titleField" },
                    "selector": "current",
                    "startField": { "$config": "startField" },
                    "endField": { "$config": "endField" }
                  },
                  "op": "not_empty"
                },
                "children": [
                  {
                    "type": "column",
                    "props": { "gap": 8 },
                    "children": [
                      {
                        "type": "text",
                        "props": {
                          "role": "label",
                          "color": { "$config": "accentColor" }
                        },
                        "binding": {
                          "source": "literal",
                          "value": "Happening now"
                        }
                      },
                      {
                        "type": "text",
                        "props": {
                          "role": "metric",
                          "fontSize": { "$config": "featuredTextSize" },
                          "color": { "$config": "foregroundColor" }
                        },
                        "binding": {
                          "source": "dataset",
                          "dataset": {
                            "$config": "dataSourceId",
                            "suffix": ":records"
                          },
                          "path": { "$config": "titleField" },
                          "selector": "current",
                          "startField": { "$config": "startField" },
                          "endField": { "$config": "endField" }
                        }
                      },
                      {
                        "$ifConfig": "showCountdown",
                        "type": "text",
                        "props": {
                          "role": "title",
                          "fontSize": { "$config": "countdownTextSize" },
                          "color": { "$config": "accentColor" }
                        },
                        "binding": {
                          "source": "dataset",
                          "dataset": {
                            "$config": "dataSourceId",
                            "suffix": ":records"
                          },
                          "path": { "$config": "endField" },
                          "selector": "current",
                          "startField": { "$config": "startField" },
                          "endField": { "$config": "endField" },
                          "format": "relative-countdown",
                          "prefix": "Ends in "
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "conditional",
                "condition": {
                  "binding": {
                    "source": "dataset",
                    "dataset": {
                      "$config": "dataSourceId",
                      "suffix": ":records"
                    },
                    "path": { "$config": "titleField" },
                    "selector": "current",
                    "startField": { "$config": "startField" },
                    "endField": { "$config": "endField" }
                  },
                  "op": "empty"
                },
                "children": [
                  {
                    "type": "column",
                    "props": { "gap": 8 },
                    "children": [
                      {
                        "type": "text",
                        "props": {
                          "role": "label",
                          "color": { "$config": "accentColor" }
                        },
                        "binding": { "source": "literal", "value": "Next up" }
                      },
                      {
                        "type": "text",
                        "props": {
                          "role": "metric",
                          "fontSize": { "$config": "featuredTextSize" },
                          "color": { "$config": "foregroundColor" }
                        },
                        "binding": {
                          "source": "dataset",
                          "dataset": {
                            "$config": "dataSourceId",
                            "suffix": ":records"
                          },
                          "path": { "$config": "titleField" },
                          "selector": "next",
                          "startField": { "$config": "startField" },
                          "endField": { "$config": "endField" },
                          "fallback": { "$config": "emptyState" }
                        }
                      },
                      {
                        "$ifConfig": "showCountdown",
                        "type": "text",
                        "props": {
                          "role": "title",
                          "fontSize": { "$config": "countdownTextSize" },
                          "color": { "$config": "accentColor" }
                        },
                        "binding": {
                          "source": "dataset",
                          "dataset": {
                            "$config": "dataSourceId",
                            "suffix": ":records"
                          },
                          "path": { "$config": "startField" },
                          "selector": "next",
                          "startField": { "$config": "startField" },
                          "endField": { "$config": "endField" },
                          "format": "relative-countdown",
                          "prefix": "Starts in "
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "$ifConfig": "showUpcomingTimeline",
                "type": "divider"
              },
              {
                "$ifConfig": "showUpcomingTimeline",
                "type": "text",
                "props": {
                  "role": "label",
                  "color": { "$config": "foregroundColor" }
                },
                "binding": { "source": "literal", "value": "Coming up" }
              },
              {
                "$ifConfig": "showUpcomingTimeline",
                "type": "conditional",
                "condition": {
                  "binding": {
                    "source": "dataset",
                    "dataset": {
                      "$config": "dataSourceId",
                      "suffix": ":records"
                    },
                    "path": { "$config": "titleField" },
                    "selector": "current",
                    "startField": { "$config": "startField" },
                    "endField": { "$config": "endField" }
                  },
                  "op": "not_empty"
                },
                "children": [
                  {
                    "type": "grid",
                    "props": {
                      "columns": { "$config": "columns" },
                      "gap": 12
                    },
                    "children": [
                      {
                        "type": "repeat",
                        "props": { "emptyState": { "$config": "emptyState" } },
                        "repeat": {
                          "dataset": {
                            "$config": "dataSourceId",
                            "suffix": ":records"
                          },
                          "limit": { "$config": "upcomingCount" },
                          "offset": 0,
                          "selector": "upcoming",
                          "startField": { "$config": "startField" },
                          "endField": { "$config": "endField" }
                        },
                        "children": [
                          {
                            "type": "column",
                            "props": {
                              "fill": false,
                              "gap": 6,
                              "background": {
                                "$config": "cardBackgroundColor"
                              },
                              "padding": 14,
                              "radius": 10
                            },
                            "children": [
                              {
                                "type": "text",
                                "props": {
                                  "role": "title",
                                  "fontSize": {
                                    "$config": "cardTitleTextSize"
                                  },
                                  "maxLines": 1,
                                  "color": { "$config": "foregroundColor" }
                                },
                                "binding": {
                                  "source": "repeat",
                                  "path": { "$config": "titleField" }
                                }
                              },
                              {
                                "type": "text",
                                "props": {
                                  "role": "body",
                                  "fontSize": {
                                    "$config": "cardDetailTextSize"
                                  },
                                  "maxLines": 1,
                                  "color": { "$config": "accentColor" }
                                },
                                "binding": {
                                  "source": "repeat",
                                  "path": { "$config": "startField" },
                                  "format": "time"
                                }
                              },
                              {
                                "type": "text",
                                "props": {
                                  "role": "body",
                                  "fontSize": {
                                    "$config": "cardDetailTextSize"
                                  },
                                  "maxLines": 1,
                                  "color": { "$config": "foregroundColor" }
                                },
                                "binding": {
                                  "source": "repeat",
                                  "path": { "$config": "locationField" },
                                  "fallback": ""
                                },
                                "condition": {
                                  "binding": {
                                    "source": "repeat",
                                    "path": { "$config": "locationField" },
                                    "fallback": ""
                                  },
                                  "op": "not_empty"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "$ifConfig": "showUpcomingTimeline",
                "type": "conditional",
                "condition": {
                  "binding": {
                    "source": "dataset",
                    "dataset": {
                      "$config": "dataSourceId",
                      "suffix": ":records"
                    },
                    "path": { "$config": "titleField" },
                    "selector": "current",
                    "startField": { "$config": "startField" },
                    "endField": { "$config": "endField" }
                  },
                  "op": "empty"
                },
                "children": [
                  {
                    "type": "grid",
                    "props": {
                      "columns": { "$config": "columns" },
                      "gap": 12
                    },
                    "children": [
                      {
                        "type": "repeat",
                        "props": { "emptyState": { "$config": "emptyState" } },
                        "repeat": {
                          "dataset": {
                            "$config": "dataSourceId",
                            "suffix": ":records"
                          },
                          "limit": { "$config": "upcomingCount" },
                          "offset": 1,
                          "selector": "upcoming",
                          "startField": { "$config": "startField" },
                          "endField": { "$config": "endField" }
                        },
                        "children": [
                          {
                            "type": "column",
                            "props": {
                              "fill": false,
                              "gap": 6,
                              "background": {
                                "$config": "cardBackgroundColor"
                              },
                              "padding": 14,
                              "radius": 10
                            },
                            "children": [
                              {
                                "type": "text",
                                "props": {
                                  "role": "title",
                                  "fontSize": {
                                    "$config": "cardTitleTextSize"
                                  },
                                  "maxLines": 1,
                                  "color": { "$config": "foregroundColor" }
                                },
                                "binding": {
                                  "source": "repeat",
                                  "path": { "$config": "titleField" }
                                }
                              },
                              {
                                "type": "text",
                                "props": {
                                  "role": "body",
                                  "fontSize": {
                                    "$config": "cardDetailTextSize"
                                  },
                                  "maxLines": 1,
                                  "color": { "$config": "accentColor" }
                                },
                                "binding": {
                                  "source": "repeat",
                                  "path": { "$config": "startField" },
                                  "format": "time"
                                }
                              },
                              {
                                "type": "text",
                                "props": {
                                  "role": "body",
                                  "fontSize": {
                                    "$config": "cardDetailTextSize"
                                  },
                                  "maxLines": 1,
                                  "color": { "$config": "foregroundColor" }
                                },
                                "binding": {
                                  "source": "repeat",
                                  "path": { "$config": "locationField" },
                                  "fallback": ""
                                },
                                "condition": {
                                  "binding": {
                                    "source": "repeat",
                                    "path": { "$config": "locationField" },
                                    "fallback": ""
                                  },
                                  "op": "not_empty"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "requiredCapabilities": {
        "layout.surface": 1,
        "layout.column": 1,
        "layout.grid": 1,
        "layout.divider": 1,
        "content.text": 1,
        "collection.repeat": 2,
        "collection.conditional": 2,
        "binding.core": 2,
        "format.typed": 2,
        "selection.temporal": 1
      },
      "emptyStateBehavior": "configured_text",
      "requiresManifestV13": true,
      "setup": {
        "eyebrow": "Needs scheduled records",
        "tip": "Calendar Data Sources expose the start and end fields this Widget needs.",
        "steps": [
          "Connect a public Calendar Data Source or choose an existing one.",
          "Map the event name, start, end, and location fields.",
          "Choose how many upcoming cards fit the screen."
        ]
      },
      "legacyEditor": false,
      "component": {
        "type": "tilecast.agenda",
        "version": 1,
        "tagName": "tc-widget-agenda",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "dataSourceId": { "$config": "dataSourceId", "default": "" },
          "titleField": { "$config": "titleField", "default": "title" },
          "startField": { "$config": "startField", "default": "startTime" },
          "endField": { "$config": "endField", "default": "endTime" },
          "locationField": { "$config": "locationField", "default": "" },
          "descriptionField": "",
          "categoryField": "",
          "heading": "",
          "maximumItems": 100,
          "groupByDay": false,
          "hideEnded": true,
          "emptyText": {
            "$config": "emptyState",
            "default": "No more events scheduled"
          },
          "style": "schedule-board",
          "nowLabel": "Happening now",
          "nextLabel": "Next up",
          "upcomingCount": { "$config": "upcomingCount", "default": 4 },
          "showCountdown": { "$config": "showCountdown", "default": true },
          "showUpcomingTimeline": {
            "$config": "showUpcomingTimeline",
            "default": true
          },
          "background": { "$config": "backgroundColor", "default": "#101f33" },
          "foreground": { "$config": "foregroundColor", "default": "#ffffff" },
          "accent": { "$config": "accentColor", "default": "#5dd6c0" },
          "cardBackground": {
            "$config": "cardBackgroundColor",
            "default": "#19324d"
          }
        },
        "dataSourceFields": ["dataSourceId"],
        "empty": "skip-eligible"
      },
      "compatibility": { "fallback": "template" },
      "deprecation": {
        "deprecated": true,
        "replacement": "agenda",
        "message": "Use Agenda with the Schedule board style for new Widgets. Saved School Schedule Widgets keep working."
      }
    }
  ],
  "dataSources": []
}
