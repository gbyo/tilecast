{
  "widgets": [
    {
      "id": "website",
      "version": 1,
      "name": "Website",
      "description": "Display an approved public webpage.",
      "category": "Web and video",
      "icon": "globe",
      "runtime": "web",
      "configurationSchema": { "fields": [] },
      "defaultConfiguration": {},
      "presentationSchemaVersion": 1,
      "requiredCapabilities": { "web.remote": 1 },
      "emptyStateBehavior": "placeholder",
      "legacyEditor": true,
      "deprecation": {}
    },
    {
      "id": "youtube",
      "version": 1,
      "name": "YouTube",
      "description": "Play a public YouTube video, playlist, or live video.",
      "category": "Video",
      "icon": "youtube",
      "kind": "app",
      "featured": true,
      "keywords": ["video", "playlist", "live", "stream"],
      "runtime": "web",
      "configurationSchema": { "fields": [] },
      "defaultConfiguration": {},
      "presentationSchemaVersion": 1,
      "requiredCapabilities": { "web.remote": 1 },
      "emptyStateBehavior": "placeholder",
      "legacyEditor": true,
      "deprecation": {}
    },
    {
      "id": "date",
      "version": 1,
      "apiVersion": 1,
      "name": "Date",
      "description": "Show a localized calendar date.",
      "category": "Essentials",
      "icon": "calendar",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "timezone",
            "label": "Timezone",
            "description": "Leave blank to use the organization timezone.",
            "control": "timezone",
            "default": "",
            "ui": { "section": "content", "order": 1 }
          },
          {
            "key": "format",
            "label": "Date format",
            "control": "select",
            "default": "locale",
            "options": [
              { "value": "locale", "label": "Weekday and date" },
              { "value": "full", "label": "Weekday and date" },
              { "value": "long", "label": "Date" },
              { "value": "medium", "label": "Short date" },
              { "value": "short", "label": "Numeric date" }
            ],
            "ui": { "section": "content", "order": 2 }
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "default": "#0E141B",
            "ui": { "section": "appearance", "order": 1 }
          },
          {
            "key": "foregroundColor",
            "label": "Text and accent color",
            "control": "color",
            "default": "#F5F7FA",
            "ui": { "section": "appearance", "order": 2 }
          },
          {
            "key": "textScale",
            "label": "Text scale",
            "control": "integer",
            "minimum": 25,
            "maximum": 500,
            "ui": { "hidden": true }
          },
          {
            "key": "contentPadding",
            "label": "Content padding",
            "control": "integer",
            "minimum": 0,
            "maximum": 40,
            "ui": { "hidden": true }
          }
        ]
      },
      "defaultConfiguration": {
        "timezone": "",
        "format": "locale",
        "backgroundColor": "#0E141B",
        "foregroundColor": "#F5F7FA"
      },
      "presentationSchemaVersion": 1,
      "requiredCapabilities": {
        "layout.surface": 1,
        "content.text": 1,
        "binding.core": 1
      },
      "emptyStateBehavior": "text",
      "legacyEditor": true,
      "deprecation": {
        "deprecated": true,
        "replacement": "clock",
        "message": "Create a Clock and choose Date instead. Saved Date content keeps working."
      },
      "component": {
        "type": "tilecast.clock",
        "version": 2,
        "tagName": "tc-widget-clock",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "mode": "date",
          "timeZone": { "$config": "timezone", "default": "" },
          "format": "locale",
          "showSeconds": false,
          "style": "standard",
          "showDate": false,
          "dateFormat": { "$config": "format", "default": "locale" },
          "zones": [],
          "background": { "$config": "backgroundColor", "default": "" },
          "foreground": { "$config": "foregroundColor", "default": "" }
        },
        "empty": "render"
      },
      "compatibility": { "fallback": "legacy" }
    },
    {
      "id": "qrcode",
      "version": 1,
      "apiVersion": 1,
      "name": "QR Code",
      "description": "Display text or a URL as a scannable code.",
      "category": "Essentials",
      "icon": "qr_code",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "payload",
            "label": "Link or text",
            "description": "What the code opens or says when scanned. Keep it short so the code stays readable from a distance.",
            "control": "text",
            "maxLength": 2048,
            "default": "",
            "ui": { "section": "content", "order": 1 }
          },
          {
            "key": "heading",
            "label": "Heading",
            "description": "Tells viewers why they should scan.",
            "control": "text",
            "maxLength": 120,
            "default": "",
            "ui": {
              "section": "content",
              "order": 2,
              "visibleWhen": { "key": "style", "notEquals": "code" }
            }
          },
          {
            "key": "instruction",
            "label": "Instruction",
            "control": "multiline_text",
            "maxLength": 300,
            "default": "",
            "ui": {
              "section": "content",
              "order": 3,
              "visibleWhen": { "key": "style", "equals": "standard" }
            }
          },
          {
            "key": "shortLabel",
            "label": "Short label",
            "description": "A short line under the code, such as the domain.",
            "control": "text",
            "maxLength": 60,
            "default": "",
            "ui": {
              "section": "content",
              "order": 4,
              "visibleWhen": { "key": "style", "equals": "standard" }
            }
          },
          {
            "key": "style",
            "label": "Style",
            "description": "Standard pairs the code with its text. Code only shows the code alone for small zones.",
            "control": "select",
            "options": [
              { "value": "standard", "label": "Standard" },
              { "value": "code", "label": "Code only" }
            ],
            "default": "standard",
            "ui": { "section": "appearance", "order": 1, "styleCard": true }
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "description": "Keep it light so the code scans reliably.",
            "control": "color",
            "default": "#FFFFFF",
            "ui": { "section": "appearance", "order": 2 }
          },
          {
            "key": "foregroundColor",
            "label": "Code color",
            "description": "Keep it dark so the code scans reliably.",
            "control": "color",
            "default": "#101418",
            "ui": { "section": "appearance", "order": 3 }
          },
          {
            "key": "errorCorrection",
            "label": "Error correction",
            "control": "select",
            "options": [
              { "value": "low", "label": "Low" },
              { "value": "medium", "label": "Medium" },
              { "value": "quartile", "label": "Quartile" },
              { "value": "high", "label": "High" }
            ],
            "ui": { "hidden": true }
          },
          {
            "key": "textScale",
            "label": "Text scale",
            "control": "integer",
            "minimum": 25,
            "maximum": 500,
            "ui": { "hidden": true }
          },
          {
            "key": "contentPadding",
            "label": "Content padding",
            "control": "integer",
            "minimum": 0,
            "maximum": 40,
            "ui": { "hidden": true }
          }
        ]
      },
      "defaultConfiguration": {
        "payload": "",
        "heading": "",
        "instruction": "",
        "shortLabel": "",
        "style": "standard",
        "backgroundColor": "#FFFFFF",
        "foregroundColor": "#101418"
      },
      "presentationSchemaVersion": 1,
      "requiredCapabilities": {
        "layout.surface": 1,
        "content.qr_code": 1,
        "binding.core": 1
      },
      "emptyStateBehavior": "text",
      "legacyEditor": true,
      "deprecation": {
        "deprecated": true,
        "replacement": "qr-code",
        "message": "Create a QR Code instead. Saved QR Code content keeps working."
      },
      "compatibility": { "fallback": "legacy" },
      "component": {
        "type": "tilecast.qr-code",
        "version": 1,
        "tagName": "tc-widget-qr-code",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "payload": {
            "$config": "payload",
            "default": { "$config": "value", "default": "" }
          },
          "heading": { "$config": "heading", "default": "" },
          "instruction": { "$config": "instruction", "default": "" },
          "shortLabel": {
            "$config": "shortLabel",
            "default": { "$config": "label", "default": "" }
          },
          "style": { "$config": "style", "default": "standard" },
          "background": { "$config": "backgroundColor", "default": "#FFFFFF" },
          "foreground": { "$config": "foregroundColor", "default": "#101418" }
        },
        "empty": "render"
      }
    },
    {
      "id": "world_clock",
      "version": 1,
      "apiVersion": 1,
      "name": "World Clock",
      "description": "Show live time in multiple configured timezones.",
      "category": "Essentials",
      "icon": "clock",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "zones",
            "label": "Zones",
            "description": "Up to eight zones. Leave a label blank to show the city name.",
            "control": "repeating_group",
            "maximumItems": 8,
            "itemFields": [
              {
                "key": "label",
                "label": "Label",
                "control": "text",
                "default": "",
                "maxLength": 80
              },
              {
                "key": "timezone",
                "label": "Timezone",
                "control": "timezone",
                "default": ""
              }
            ],
            "default": [],
            "ui": { "section": "content", "order": 1 }
          },
          {
            "key": "format",
            "label": "Time format",
            "control": "select",
            "default": "locale",
            "options": [
              { "value": "locale", "label": "Use organization setting" },
              { "value": "12", "label": "12-hour" },
              { "value": "24", "label": "24-hour" }
            ],
            "ui": { "section": "content", "order": 2 }
          },
          {
            "key": "showSeconds",
            "label": "Show seconds",
            "control": "boolean",
            "default": false,
            "ui": { "section": "content", "order": 3 }
          },
          {
            "key": "showDate",
            "label": "Show date",
            "control": "boolean",
            "default": true,
            "ui": { "section": "content", "order": 4 }
          },
          {
            "key": "columns",
            "label": "Columns",
            "control": "integer",
            "minimum": 1,
            "maximum": 4,
            "ui": { "hidden": true }
          },
          {
            "key": "emptyState",
            "label": "Empty state",
            "control": "multiline_text",
            "maxLength": 240,
            "ui": { "hidden": true }
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "default": "#0E141B",
            "ui": { "section": "appearance", "order": 1 }
          },
          {
            "key": "foregroundColor",
            "label": "Text and accent color",
            "control": "color",
            "default": "#F5F7FA",
            "ui": { "section": "appearance", "order": 2 }
          },
          {
            "key": "textScale",
            "label": "Text scale",
            "control": "integer",
            "minimum": 25,
            "maximum": 500,
            "ui": { "hidden": true }
          },
          {
            "key": "contentPadding",
            "label": "Content padding",
            "control": "integer",
            "minimum": 0,
            "maximum": 40,
            "ui": { "hidden": true }
          }
        ]
      },
      "defaultConfiguration": {
        "zones": [],
        "format": "locale",
        "showSeconds": false,
        "showDate": true,
        "backgroundColor": "#0E141B",
        "foregroundColor": "#F5F7FA"
      },
      "presentationSchemaVersion": 1,
      "requiredCapabilities": {
        "layout.surface": 1,
        "layout.grid": 1,
        "layout.column": 1,
        "content.text": 1,
        "binding.core": 1
      },
      "emptyStateBehavior": "text",
      "legacyEditor": true,
      "requiresManifestV13": true,
      "deprecation": {
        "deprecated": true,
        "replacement": "clock",
        "message": "Create a Clock and choose World clocks instead. Saved World Clock content keeps working."
      },
      "component": {
        "type": "tilecast.clock",
        "version": 2,
        "tagName": "tc-widget-clock",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "mode": "world",
          "timeZone": "",
          "format": { "$config": "format", "default": "locale" },
          "showSeconds": { "$config": "showSeconds", "default": false },
          "style": "standard",
          "showDate": { "$config": "showDate", "default": false },
          "dateFormat": "locale",
          "zones": { "$config": "zones", "default": [] },
          "background": { "$config": "backgroundColor", "default": "" },
          "foreground": { "$config": "foregroundColor", "default": "" }
        },
        "empty": "render"
      },
      "compatibility": { "fallback": "legacy" }
    },
    {
      "id": "stat_grid",
      "version": 1,
      "apiVersion": 1,
      "name": "Stat Grid",
      "description": "Display a responsive grid of numeric values.",
      "category": "Data Display",
      "icon": "grid",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "dataSourceId",
            "label": "Data Source",
            "description": "The records or single-object source these metrics read.",
            "control": "data_source",
            "acceptedDataSourceKinds": ["records", "object"],
            "default": "",
            "ui": { "section": "data", "order": 1 }
          },
          {
            "key": "metrics",
            "label": "Metrics",
            "description": "Up to twelve numeric values. Each names its own field.",
            "control": "repeating_group",
            "maximumItems": 12,
            "default": [],
            "itemFields": [
              {
                "key": "valueField",
                "label": "Value field",
                "control": "data_source_field",
                "dataSourceKey": "dataSourceId",
                "dataSourceFieldTypes": ["number", "integer", "percent", "currency"],
                "default": ""
              },
              {
                "key": "label",
                "label": "Label",
                "control": "text",
                "maxLength": 80,
                "default": ""
              },
              {
                "key": "labelField",
                "label": "Label field",
                "control": "data_source_field",
                "dataSourceKey": "dataSourceId",
                "dataSourceFieldTypes": ["text", "number", "integer", "currency", "percent", "boolean", "date", "datetime"],
                "default": ""
              },
              {
                "key": "detailField",
                "label": "Detail field",
                "control": "data_source_field",
                "dataSourceKey": "dataSourceId",
                "dataSourceFieldTypes": ["text", "number", "integer", "currency", "percent", "boolean", "date", "datetime"],
                "default": ""
              },
              {
                "key": "format",
                "label": "Format",
                "control": "select",
                "default": "number",
                "options": [
                  { "value": "number", "label": "Number" },
                  { "value": "integer", "label": "Whole number" },
                  { "value": "percent", "label": "Percent" },
                  { "value": "currency", "label": "Currency" }
                ]
              },
              {
                "key": "precision",
                "label": "Decimals",
                "control": "integer",
                "minimum": 0,
                "maximum": 6,
                "default": 1
              },
              {
                "key": "prefix",
                "label": "Prefix",
                "control": "text",
                "maxLength": 20,
                "default": ""
              },
              {
                "key": "suffix",
                "label": "Suffix",
                "control": "text",
                "maxLength": 20,
                "default": ""
              }
            ],
            "ui": { "section": "data", "order": 2 }
          },
          {
            "key": "columns",
            "label": "Columns",
            "description": "Legacy grid width. Old Players still read it; the component lays itself out.",
            "control": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 2,
            "ui": { "hidden": true }
          },
          {
            "key": "emptyText",
            "label": "Empty message",
            "control": "text",
            "maxLength": 200,
            "default": "",
            "ui": { "section": "content", "order": 1 }
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "default": "",
            "ui": { "section": "appearance", "order": 1 }
          },
          {
            "key": "foregroundColor",
            "label": "Text color",
            "control": "color",
            "default": "",
            "ui": { "section": "appearance", "order": 2 }
          },
          {
            "key": "textScale",
            "label": "Text scale",
            "control": "integer",
            "minimum": 25,
            "maximum": 500,
            "ui": { "hidden": true }
          },
          {
            "key": "contentPadding",
            "label": "Content padding",
            "control": "integer",
            "minimum": 0,
            "maximum": 40,
            "ui": { "hidden": true }
          }
        ]
      },
      "defaultConfiguration": {
        "dataSourceId": "",
        "metrics": [],
        "emptyText": "",
        "backgroundColor": "",
        "foregroundColor": ""
      },
      "presentationSchemaVersion": 1,
      "requiredCapabilities": {
        "layout.surface": 1,
        "layout.grid": 1,
        "layout.column": 1,
        "content.text": 1,
        "binding.core": 2
      },
      "emptyStateBehavior": "text",
      "legacyEditor": true,
      "requiresManifestV13": true,
      "deprecation": {
        "deprecated": true,
        "replacement": "metric",
        "message": "Create Metrics instead. Saved Stat Grid content keeps working."
      },
      "component": {
        "type": "tilecast.metrics",
        "version": 1,
        "tagName": "tc-widget-metrics",
        "entrypoint": "./runtime/index.ts",
        "configTemplate": {
          "dataSourceId": { "$config": "dataSourceId", "default": "" },
          "metrics": { "$config": "metrics", "default": [] },
          "emptyText": {
            "$config": "emptyText",
            "default": { "$config": "emptyState", "default": "" }
          },
          "background": { "$config": "backgroundColor", "default": "" },
          "foreground": { "$config": "foregroundColor", "default": "" }
        },
        "dataSourceFields": ["dataSourceId"],
        "empty": "skip-eligible"
      },
      "compatibility": { "fallback": "legacy" }
    },
    {
      "id": "timeline",
      "version": 1,
      "name": "Timeline",
      "description": "Display ordered dated milestones and statuses.",
      "category": "Schedules",
      "icon": "timeline",
      "runtime": "native",
      "configurationSchema": { "fields": [] },
      "defaultConfiguration": {},
      "presentationSchemaVersion": 1,
      "requiredCapabilities": {
        "layout.surface": 1,
        "layout.column": 1,
        "collection.repeat": 2,
        "content.text": 1,
        "content.badge": 1,
        "binding.core": 2
      },
      "emptyStateBehavior": "text",
      "legacyEditor": true,
      "requiresManifestV13": true,
      "deprecation": {}
    },
    {
      "id": "school-status-banner",
      "version": 1,
      "name": "School Status Banner",
      "description": "Displays a school status, severity, message, and update time.",
      "category": "Information",
      "icon": "school",
      "runtime": "native",
      "configurationSchema": {
        "fields": [
          {
            "key": "dataSourceId",
            "label": "Data Source",
            "control": "data_source",
            "required": true,
            "acceptedDataSourceKinds": ["object"],
            "requiredFields": {
              "status": "text",
              "message": "text",
              "severity": "text",
              "updatedAt": "datetime"
            }
          },
          {
            "key": "heading",
            "label": "Heading",
            "control": "text",
            "required": true,
            "minLength": 1,
            "maxLength": 120,
            "default": "School Status"
          },
          {
            "key": "statusField",
            "label": "Status field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": ["text"],
            "default": "status"
          },
          {
            "key": "messageField",
            "label": "Message field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": ["text"],
            "default": "message"
          },
          {
            "key": "severityField",
            "label": "Severity field",
            "control": "data_source_field",
            "required": true,
            "dataSourceFieldTypes": ["text"],
            "default": "severity"
          },
          {
            "key": "showUpdatedTime",
            "label": "Show updated time",
            "control": "boolean",
            "default": true
          },
          {
            "key": "foregroundColor",
            "label": "Foreground color",
            "control": "color",
            "required": true,
            "default": "#ffffff"
          },
          {
            "key": "backgroundColor",
            "label": "Background color",
            "control": "color",
            "required": true,
            "default": "#17324d"
          },
          {
            "key": "emptyState",
            "label": "Empty-state text",
            "control": "multiline_text",
            "required": true,
            "maxLength": 500,
            "default": "Status is unavailable"
          }
        ]
      },
      "defaultConfiguration": {
        "dataSourceId": "",
        "heading": "School Status",
        "statusField": "status",
        "messageField": "message",
        "severityField": "severity",
        "showUpdatedTime": true,
        "foregroundColor": "#ffffff",
        "backgroundColor": "#17324d",
        "emptyState": "Status is unavailable"
      },
      "acceptedDataSourceKinds": ["object"],
      "requiredFieldTypes": {
        "status": "text",
        "message": "text",
        "severity": "text",
        "updatedAt": "datetime"
      },
      "presentationSchemaVersion": 1,
      "presentationTemplate": {
        "type": "surface",
        "props": {
          "backgroundColor": { "$config": "backgroundColor" },
          "padding": 12
        },
        "children": [
          {
            "type": "column",
            "children": [
              {
                "type": "text",
                "props": {
                  "color": { "$config": "foregroundColor" },
                  "role": "title"
                },
                "binding": {
                  "source": "literal",
                  "value": { "$config": "heading" }
                }
              },
              {
                "type": "badge",
                "props": { "color": { "$config": "foregroundColor" } },
                "binding": {
                  "source": "dataset",
                  "dataset": { "$config": "dataSourceId", "suffix": ":object" },
                  "path": { "$config": "severityField" },
                  "fallback": { "$config": "emptyState" }
                }
              },
              {
                "type": "text",
                "props": {
                  "color": { "$config": "foregroundColor" },
                  "role": "metric"
                },
                "binding": {
                  "source": "dataset",
                  "dataset": { "$config": "dataSourceId", "suffix": ":object" },
                  "path": { "$config": "statusField" },
                  "fallback": { "$config": "emptyState" }
                }
              },
              {
                "type": "text",
                "props": {
                  "color": { "$config": "foregroundColor" },
                  "role": "body"
                },
                "binding": {
                  "source": "dataset",
                  "dataset": { "$config": "dataSourceId", "suffix": ":object" },
                  "path": { "$config": "messageField" },
                  "fallback": { "$config": "emptyState" }
                }
              },
              {
                "$ifConfig": "showUpdatedTime",
                "type": "conditional",
                "condition": {
                  "binding": {
                    "source": "dataset",
                    "dataset": {
                      "$config": "dataSourceId",
                      "suffix": ":object"
                    },
                    "path": "updatedAt"
                  },
                  "op": "not_empty"
                },
                "children": [
                  {
                    "type": "text",
                    "props": {
                      "color": { "$config": "foregroundColor" },
                      "role": "label"
                    },
                    "binding": {
                      "source": "dataset",
                      "dataset": {
                        "$config": "dataSourceId",
                        "suffix": ":object"
                      },
                      "path": "updatedAt",
                      "format": "datetime",
                      "prefix": "Updated "
                    }
                  }
                ]
              }
