{
  "sourceLanguage": "en",
  "strings": {
    "%@ now belongs to a different Tilecast installation (%@). Tilecast didn’t open it, so your sign-in for %@ wasn’t sent to it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ahora pertenece a otra instalación de Tilecast (%2$@). Tilecast no la abrió, así que tu inicio de sesión de %3$@ no se le envió."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ теперь принадлежит другой установке Tilecast (%2$@). Tilecast не открыл её, поэтому ваш вход для %3$@ ей не отправлен."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        }
      }
    },
    "Add Media": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar contenido multimedia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить медиафайлы"
          }
        }
      }
    },
