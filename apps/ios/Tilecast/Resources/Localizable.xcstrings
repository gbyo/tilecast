    "Use New Server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el nuevo servidor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать новый сервер"
          }
        }
      }
    },
    "Use New Server…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el nuevo servidor…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать новый сервер…"
          }
        }
      }
    },
    "Use an address that starts with https:// or, on a local network, http://.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una dirección que empiece por https:// o, en una red local, por http://."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте адрес, начинающийся с https://, а в локальной сети — с http://."
          }
        }
      }
    },
    "Use the new server at this address?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usar el nuevo servidor en esta dirección?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать новый сервер по этому адресу?"
          }
        }
      }
    },
    "Website data for %@ on this device, including your sign-in, is deleted. Continue only if the server was reinstalled or restored intentionally.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los datos de sitios web de %@ en este dispositivo, incluido tu inicio de sesión. Continúa solo si el servidor se reinstaló o restauró intencionadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные сайта для %@ на этом устройстве, включая ваш вход, будут удалены. Продолжайте, только если сервер был намеренно переустановлен или восстановлен."
          }
        }
      }
    },
    "Couldn’t Open This View": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir esta vista"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть это окно"
          }
        }
      }
    },
    "Couldn’t Sign In": {
      "localizations": {
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo iniciar sesión" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось войти" } }
      }
    },
    "Sign In": {
      "localizations": {
