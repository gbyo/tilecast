      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменено"
          }
        }
      }
    },
    "Can’t Open Link": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir el enlace"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся открыть ссылку"
          }
        }
      }
    },
    "Can’t Reach Server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al servidor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер недоступен"
          }
        }
      }
    },
    "Certificate Not Trusted": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado no confiable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат не является доверенным"
          }
        }
      }
    },
    "Check that you’re on the same network as the server and that Local Network access for Tilecast is on in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que estás en la misma red que el servidor y que el acceso a la red local para Tilecast está activado en Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что вы в одной сети с сервером и что доступ к локальной сети для Tilecast включён в Настройках."
          }
        }
      }
    },
    "Check your connection, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение и повторите попытку."
          }
        }
      }
    },
    "Check your internet connection and that the server is running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión a internet y que el servidor esté en funcionamiento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение к интернету и убедитесь, что сервер работает."
          }
        }
      }
    },
    "Choose a Server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un servidor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сервер"
          }
        }
      }
    },
    "Choose Files…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir archivos…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать файлы…"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "Connect to your organization’s Tilecast server to manage screens, content, and schedules.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate al servidor de Tilecast de tu organización para administrar pantallas, contenido y programaciones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к серверу Tilecast вашей организации, чтобы управлять экранами, контентом и расписаниями."
          }
        }
      }
    },
    "Connecting to %@…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con %@…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к %@…"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
      }
    },
    "Couldn’t reach the server. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервером. Проверьте подключение и повторите попытку."
          }
        }
      }
    },
    "Couldn’t read this file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer este archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать этот файл."
          }
        }
      }
    },
    "Current server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor actual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий сервер"
          }
        }
      }
    },
    "Different Tilecast Server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro servidor de Tilecast"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой сервер Tilecast"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Downloads Aren’t Available Yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas aún no están disponibles"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки пока недоступны"
          }
        }
      }
    },
    "Each server keeps its own sign-in and website data on this device. Removing a server deletes that data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor guarda su propio inicio de sesión y datos de sitios web en este dispositivo. Al quitar un servidor, se eliminan esos datos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый сервер хранит на этом устройстве собственный вход и данные сайта. При удалении сервера эти данные удаляются."
          }
        }
      }
    },
    "Enter only the server address, without a path such as /login.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe solo la dirección del servidor, sin una ruta como /login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите только адрес сервера, без пути вроде /login."
          }
        }
      }
    },
    "Enter the address you use for Tilecast Studio. Plain HTTP works only for local network addresses.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la dirección que usas para Tilecast Studio. HTTP sin cifrar solo funciona con direcciones de la red local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес, который вы используете для Tilecast Studio. Незашифрованный HTTP работает только для адресов локальной сети."
          }
        }
      }
    },
    "Enter your Tilecast server address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la dirección de tu servidor de Tilecast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес сервера Tilecast."
          }
        }
      }
    },
    "Item %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemento %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент %lld"
          }
        }
      }
    },
    "Its website data on this device, including your sign-in, is deleted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán sus datos de sitios web en este dispositivo, incluido tu inicio de sesión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его данные сайта на этом устройстве, включая ваш вход, будут удалены."
          }
        }
      }
    },
