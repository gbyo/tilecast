      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección del servidor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес сервера"
          }
        }
      }
    },
    "Servers": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы"
          }
        }
      }
    },
    "Servers on the internet must use HTTPS. Plain HTTP works only for local network addresses such as 192.168.1.20 or tilecast.local.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores en internet deben usar HTTPS. HTTP sin cifrar solo funciona con direcciones de la red local, como 192.168.1.20 o tilecast.local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы в интернете должны использовать HTTPS. Незашифрованный HTTP работает только для адресов локальной сети, например 192.168.1.20 или tilecast.local."
          }
        }
      }
    },
    "Shown in the server switcher on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra en el selector de servidores de este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается в переключателе серверов на этом устройстве."
          }
        }
      }
    },
    "Something answered at this address, but it isn’t a Tilecast server. Check the address you use for Tilecast Studio.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo respondió en esta dirección, pero no es un servidor de Tilecast. Comprueba la dirección que usas para Tilecast Studio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этому адресу что-то ответило, но это не сервер Tilecast. Проверьте адрес, который вы используете для Tilecast Studio."
          }
        }
      }
    },
    "Studio Couldn’t Load": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar Studio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить Studio"
          }
        }
      }
    },
    "That doesn’t look like a server address. Enter a host name such as signage.example.org.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece una dirección de servidor. Escribe un nombre de host como signage.example.org."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не похоже на адрес сервера. Введите имя хоста, например signage.example.org."
          }
        }
      }
    },
    "The server couldn’t process this file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no pudo procesar este archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не смог обработать этот файл."
          }
        }
      }
    },
    "The server didn’t accept this upload.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no aceptó esta carga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не принял эту загрузку."
          }
        }
      }
    },
    "The server has no space left.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no tiene espacio disponible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервере не осталось места."
          }
        }
      }
    },
    "The server’s certificate isn’t valid or isn’t trusted by this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado del servidor no es válido o este dispositivo no confía en él."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат сервера недействителен или не является доверенным для этого устройства."
          }
        }
      }
    },
    "The server’s certificate isn’t valid or isn’t trusted by this device. Tilecast only connects to servers with a trusted certificate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado del servidor no es válido o este dispositivo no confía en él. Tilecast solo se conecta a servidores con un certificado de confianza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат сервера недействителен или не является доверенным для этого устройства. Tilecast подключается только к серверам с доверенным сертификатом."
          }
        }
      }
    },
    "This file is larger than the server allows.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo es más grande de lo que permite el servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл больше, чем разрешено на сервере."
          }
        }
      }
    },
    "This link can’t be opened.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir este enlace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту ссылку не удаётся открыть."
          }
        }
      }
    },
    "This link is for a Tilecast server that isn’t set up on this device. Add the server first, then open the link again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace es para un servidor de Tilecast que no está configurado en este dispositivo. Agrega primero el servidor y vuelve a abrir el enlace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка относится к серверу Tilecast, который не настроен на этом устройстве. Сначала добавьте сервер, затем откройте ссылку снова."
          }
        }
      }
    },
    "This server doesn’t accept this type of file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no acepta este tipo de archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер не принимает файлы такого типа."
          }
        }
      }
    },
    "This Tilecast server is already added as “%@”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor de Tilecast ya está agregado como «%@»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер Tilecast уже добавлен как «%@»."
          }
        }
      }
    },
    "This connection isn’t encrypted. Use it only on a network you trust.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión no está cifrada. Úsala solo en una red de confianza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это подключение не зашифровано. Используйте его только в доверенной сети."
          }
        }
      }
    },
    "This server uses a newer Tilecast version than this app supports. Update the app to connect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa una versión de Tilecast más reciente de la que admite esta app. Actualiza la app para conectarte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер использует более новую версию Tilecast, чем поддерживает приложение. Обновите приложение, чтобы подключиться."
          }
        }
      }
    },
    "This view stopped unexpectedly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vista se detuvo inesperadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окно неожиданно закрылось."
          }
        }
      }
    },
    "Tilecast": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast"
          }
        }
      }
    },
    "Tilecast can’t scan QR codes without camera access. Enter the pairing code from the Player instead, or allow the camera in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast no puede escanear códigos QR sin acceso a la cámara. Introduce el código de emparejamiento del reproductor o permite el acceso a la cámara en Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast не может сканировать QR-коды без доступа к камере. Введите код подключения с плеера или разрешите доступ к камере в «Настройках»."
          }
        }
      }
    },
    "Tilecast isn’t signed in to this server. Sign in again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast no ha iniciado sesión en este servidor. Inicia sesión de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast не выполнил вход на этом сервере. Войдите снова."
          }
        }
      }
    },
    "Tilecast Studio couldn’t be loaded (%@ %lld).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar Tilecast Studio (%1$@ %2$lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить Tilecast Studio (%1$@ %2$lld)."
          }
        }
      }
    },
    "Tilecast Studio couldn’t open this view.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast Studio no pudo abrir esta vista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast Studio не удалось открыть это окно."
          }
        }
      }
    },
    "Tilecast Studio stopped unexpectedly several times.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast Studio se detuvo inesperadamente varias veces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecast Studio несколько раз неожиданно остановился."
          }
        }
      }
    },
    "To download this file, open Tilecast Studio in Safari.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para descargar este archivo, abre Tilecast Studio en Safari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы загрузить этот файл, откройте Tilecast Studio в Safari."
          }
        }
      }
    },
