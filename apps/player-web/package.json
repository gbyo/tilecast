{
  "name": "@tilecast/player-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "deps": "npm run build:node --workspace @tilecast/player-runtime",
    "build": "npm run deps && npm run build:runtime --workspace @tilecast/player-runtime && node scripts/build.mjs",
    "pretypecheck": "npm run deps",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run deps",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@tilecast/player-runtime": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.4",
    "sharp": "0.35.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  }
}
