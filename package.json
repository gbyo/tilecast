{
  "name": "tilecast",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/dashboard",
    "apps/docs",
    "apps/player-linux",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @tilecast/dashboard",
    "dev": "npm run dev --workspace @tilecast/dashboard",
    "docs:dev": "npm run dev --workspace @tilecast/docs --",
    "docs:check": "npm run check --workspace @tilecast/docs",
    "docs:build": "npm run build --workspace @tilecast/docs",
    "docs:preview": "npm run preview --workspace @tilecast/docs --",
    "player:linux": "npm start --workspace @gibsonmb71/tilecast-player-linux",
    "player:linux:build": "npm run build --workspace @gibsonmb71/tilecast-player-linux",
    "player:linux:test": "npm test --workspace @gibsonmb71/tilecast-player-linux",
    "helper:test": "python3 -m unittest discover -s apps/player-linux/helper",
    "player:linux:dist": "npm run dist --workspace @gibsonmb71/tilecast-player-linux",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace @tilecast/dashboard",
    "test": "npm run test --workspace @tilecast/dashboard",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "plugins:check": "node packages/plugin-sdk/tools/pluginctl/main.ts check",
    "plugins:generate": "node packages/plugin-sdk/tools/pluginctl/main.ts generate",
    "plugins:new": "node packages/plugin-sdk/tools/pluginctl/main.ts new",
    "plugins:migration": "node packages/plugin-sdk/tools/pluginctl/main.ts migration"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6"
  }
}
