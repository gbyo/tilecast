{
  "name": "tilecast",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/dashboard",
    "apps/docs",
    "apps/player-linux",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @tilecast/dashboard",
    "dev": "npm run dev --workspace @tilecast/dashboard",
    "docs:dev": "npm run dev --workspace @tilecast/docs --",
    "docs:check": "npm run check --workspace @tilecast/docs",
    "docs:build": "npm run build --workspace @tilecast/docs",
    "docs:preview": "npm run preview --workspace @tilecast/docs --",
    "player:linux": "npm start --workspace @gibsonmb71/tilecast-player-linux",
    "player:linux:build": "npm run build --workspace @gibsonmb71/tilecast-player-linux",
    "player:linux:test": "npm test --workspace @gibsonmb71/tilecast-player-linux",
    "helper:test": "python3 -m unittest discover -s apps/player-linux/helper",
    "player-contracts:generate": "node scripts/generate-player-contracts.mjs",
    "player-contracts:check": "node scripts/generate-player-contracts.mjs --check",
    "player:linux:dist": "npm run dist --workspace @gibsonmb71/tilecast-player-linux",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace @tilecast/dashboard",
    "openapi:lint": "redocly lint docs/openapi.yaml",
    "openapi:compat": "./scripts/ci/openapi-compat.sh",
    "test": "npm run test --workspace @tilecast/dashboard",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:visual": "playwright test -c e2e/visual/playwright.config.ts",
    "test:visual:probe": "playwright test -c e2e/visual/probe.config.ts",
    "test:ci": "node --test scripts/ci/*.test.mjs scripts/ci/contracts/*.test.mjs",
    "coverage": "npm run coverage --workspace @tilecast/dashboard",
    "plugins:check": "node packages/plugin-sdk/tools/pluginctl/main.ts check",
    "plugins:generate": "node packages/plugin-sdk/tools/pluginctl/main.ts generate",
    "plugins:new": "node packages/plugin-sdk/tools/pluginctl/main.ts new",
    "plugins:migration": "node packages/plugin-sdk/tools/pluginctl/main.ts migration",
    "data-sources:check": "node packages/data-source-sdk/tools/datactl/main.ts check && npm run test --workspace @tilecast/data-source-sdk",
    "data-sources:generate": "node packages/data-source-sdk/tools/datactl/main.ts generate",
    "data-sources:new": "node packages/data-source-sdk/tools/datactl/main.ts new",
    "extensions:check": "npm run plugins:check && npm run widgets:check && npm run data-sources:check",
    "extensions:generate": "npm run plugins:generate && npm run widgets:generate && npm run data-sources:generate",
    "widgets:check": "node packages/widget-sdk/tools/widgetctl/main.ts check && npm run test:widgets --workspace @tilecast/widget-sdk",
    "widgets:generate": "node packages/widget-sdk/tools/widgetctl/main.ts generate",
    "widgets:new": "node packages/widget-sdk/tools/widgetctl/main.ts new",
    "widgets:storybook": "storybook dev -c widgets/.storybook -p 6006 --no-open",
    "widgets:storybook:build": "storybook build -c widgets/.storybook -o widgets/storybook-static --quiet",
    "widgets:visual": "npm run widgets:storybook:build && playwright test -c widgets/visual/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "2.54.3",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "yaml": "^2.9.1"
  }
}
